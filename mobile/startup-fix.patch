+    "aspia-android-arm64" => {
+        inherit_from => [ "android-arm64" ],
+        shlib_variant => "_3",
+        shared_extension => ".so",
+    },
+);
+OPENSSL_TARGET
+./Configure shared aspia-android-arm64 -D__ANDROID_API__=31 no-tests no-apps \
+    '-Wl,-z,max-page-size=16384'
+make -j"${ASPIA_BUILD_JOBS:-4}" build_libs
+cp libcrypto_3.so "$output_dir/libcrypto_3.so"
+cp libssl_3.so "$output_dir/libssl_3.so"
 cp LICENSE.txt "$output_dir/OpenSSL-LICENSE.txt"
