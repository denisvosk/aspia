-    for segment in segments:
+    for index, segment in enumerate(segments):
         alignment = segment["alignment"]
         if alignment < PAGE_SIZE or alignment & (alignment - 1):
             errors.append(f"PT_LOAD alignment {alignment} is below 16 KiB or not a power of two")
-        if (segment["offset"] - segment["virtual_address"]) % PAGE_SIZE:
-            errors.append("PT_LOAD offset and virtual address are not congruent modulo 16 KiB")
+        # Checking p_align alone or readelf -V is insufficient. A patchelf-created
+        # LOAD in mobile.2 had p_align=64 KiB but p_offset=0x5774e8 and
+        # p_vaddr=0x590000. Android mapped .dynstr at the wrong byte offset and
+        # reported an apparently missing verneed dependency ("_meth_data").
+        # ELF gABI: https://gabi.xinuos.com/elf/08-pheader.html
+        delta = segment["offset"] - segment["virtual_address"]
+        incongruent = [label for size, label in ((4096, "4 KiB"), (PAGE_SIZE, "16 KiB"))
+                       if delta % size]
+        if alignment > 1 and delta % alignment:
+            incongruent.append(f"p_align ({alignment:#x})")
+        if incongruent:
+            errors.append(
+                f"PT_LOAD[{index}] p_offset={segment['offset']:#x} "
+                f"p_vaddr={segment['virtual_address']:#x} are not congruent modulo "
+                + ", ".join(incongruent))
     return errors
 
 
