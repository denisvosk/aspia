diff --git a/ci/build-android-openssl.sh b/ci/build-android-openssl.sh
new file mode 100755
index 0000000000000000000000000000000000000000..bc4e43b333e3e4b4ac9a6f57d6ff5acf78976619
--- /dev/null
+++ b/ci/build-android-openssl.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set -euo pipefail
+# Qt for Android needs dynamically loadable, suffixed OpenSSL libraries for HTTPS.
+# Aspia's protocol crypto remains linked from the pinned vcpkg dependency.
+: "${ANDROID_NDK_ROOT:?Set ANDROID_NDK_ROOT to Android NDK 27.2.12479018}"
+output_dir=${1:?Usage: build-android-openssl.sh OUTPUT_DIRECTORY [SOURCE_ARCHIVE]}
+archive_path=${2:-}
+script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+repo_dir=$(cd "$script_dir/.." && pwd)
+mkdir -p "$output_dir"
+output_dir=$(cd "$output_dir" && pwd)
+if [[ -z "$archive_path" ]]; then
+    archive_path="$output_dir/openssl-3.6.3.tar.gz"
+    if [[ ! -f "$archive_path" ]]; then
+        curl --fail --location --retry 3 -o "$archive_path" \
+          https://github.com/openssl/openssl/archive/openssl-3.6.3.tar.gz
+    fi
+fi
+archive_path=$(realpath "$archive_path")
+printf '%s  %s\n' c5524dd6bfaa8e8ff0f1be885c390d14f3ff0bd2de62a7311b65fcbb75cb7546 "$archive_path" | sha256sum --check
+command -v patchelf > /dev/null
+source_dir="$output_dir/openssl-source"
+mkdir -p "$source_dir"
+if [[ ! -f "$source_dir/Configure" ]]; then
+    tar -xf "$archive_path" -C "$source_dir" --strip-components=1
+fi
+export PATH="$ANDROID_NDK_ROOT/toolchains/llvm/prebuilt/linux-x86_64/bin:$PATH"
+export ANDROID_NDK_HOME="$ANDROID_NDK_ROOT"
+cd "$source_dir"
+if [[ ! -f Makefile ]]; then
+    ./Configure shared android-arm64 -D__ANDROID_API__=31 no-tests no-apps \
+        '-Wl,-z,max-page-size=16384'
+fi
+make -j"${ASPIA_BUILD_JOBS:-4}" SHLIB_VERSION_NUMBER= build_libs
+cp libcrypto.so "$output_dir/libcrypto_3.so"
+cp libssl.so "$output_dir/libssl_3.so"
+patchelf --set-soname libcrypto_3.so "$output_dir/libcrypto_3.so"
+patchelf --set-soname libssl_3.so "$output_dir/libssl_3.so"
+for old_name in libcrypto.so libcrypto.so.3; do
+    patchelf --replace-needed "$old_name" libcrypto_3.so "$output_dir/libssl_3.so"
+done
+cp LICENSE.txt "$output_dir/OpenSSL-LICENSE.txt"
+# Generated native libraries contain no credentials or private signing material.
diff --git a/ci/check-android-apk.py b/ci/check-android-apk.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed1c7b805671f0b918d7320008286a979c0ce11b
--- /dev/null
+++ b/ci/check-android-apk.py
@@ -0,0 +1,309 @@
+#!/usr/bin/env python3
+"""Verify an Aspia+ Mobile release APK as a package, not as a running Android app.
+
+Uses Android SDK aapt/apksigner/zipalign and NDK llvm-readelf. No signing key is
+read. A passing report verifies package metadata, signature, native dependency
+closure and 16 KiB alignment; it does not verify device UI or remote sessions.
+"""
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import zipfile
+
+
+# Public Android/NDK libraries available at minSdk 31. libc++_shared, OpenSSL and
+# ICU deliberately are not system dependencies: the APK must provide them.
+ANDROID_SYSTEM_LIBS = frozenset({
+    "libc.so", "libm.so", "libdl.so", "liblog.so", "libandroid.so",
+    "libjnigraphics.so", "libEGL.so", "libGLESv1_CM.so", "libGLESv2.so",
+    "libGLESv3.so", "libOpenSLES.so", "libOpenMAXAL.so", "libmediandk.so",
+    "libaaudio.so", "libamidi.so", "libvulkan.so", "libcamera2ndk.so",
+    "libnativewindow.so", "libneuralnetworks.so", "libsync.so", "libbinder_ndk.so",
+    "libz.so",
+})
+PAGE_SIZE = 16 * 1024
+
+
+def parse_badging(text):
+    result = {"native_abis": [], "debuggable": False}
+    for line in text.splitlines():
+        if line.startswith("package: "):
+            fields = dict(re.findall(r"([A-Za-z][A-Za-z0-9_-]*)='([^']*)'", line))
+            result["package"] = fields.get("name")
+            result["version_name"] = fields.get("versionName")
+            result["version_code"] = int(fields.get("versionCode", "-1"))
+        elif line.startswith("sdkVersion:"):
+            result["min_sdk"] = int(re.search(r"'([0-9]+)'", line).group(1))
+        elif line.startswith("targetSdkVersion:"):
+            result["target_sdk"] = int(re.search(r"'([0-9]+)'", line).group(1))
+        elif line.startswith("native-code:"):
+            result["native_abis"] = re.findall(r"'([^']+)'", line)
+        elif line.startswith("application-debuggable"):
+            result["debuggable"] = True
+    return result
+
+
+def normalize_fingerprint(value):
+    value = re.sub(r"[:\s]", "", value).lower()
+    if not re.fullmatch(r"[0-9a-f]{64}", value):
+        raise ValueError("The expected certificate fingerprint must be a SHA-256 digest")
+    return value
+
+
+def parse_signatures(text):
+    fingerprints = re.findall(
+        r"^Signer #[0-9]+ certificate SHA-256 digest:\s*([0-9a-fA-F: ]+)\s*$",
+        text, re.MULTILINE)
+    schemes = {name: value == "true" for name, value in re.findall(
+        r"Verified using (v[0-9.]+) scheme[^\n]*:\s*(true|false)", text)}
+    return {"certificate_sha256": [normalize_fingerprint(value) for value in fingerprints],
+            "schemes": schemes}
+
+
+def parse_elf(text):
+    def header(name):
+        match = re.search(rf"^\s*{name}:\s*(.*?)\s*$", text, re.MULTILINE)
+        return match.group(1) if match else None
+    soname = re.search(r"\(SONAME\).*?\[([^]]+)\]", text)
+    result = {"class": header("Class"), "machine": header("Machine"),
+              "soname": soname.group(1) if soname else None,
+              "needed": re.findall(r"\(NEEDED\).*?\[([^]]+)\]", text), "load_segments": []}
+    for line in text.splitlines():
+        fields = line.split()
+        if fields and fields[0] == "LOAD":
+            if len(fields) < 8:
+                raise ValueError("Unexpected PT_LOAD layout; llvm-readelf -W is required")
+            result["load_segments"].append({
+                "offset": int(fields[1], 0), "virtual_address": int(fields[2], 0),
+                "alignment": int(fields[-1], 0),
+            })
+    return result
+
+
+def native_errors(library):
+    errors = []
+    if library["class"] != "ELF64" or library["machine"] != "AArch64":
+        errors.append("Native code is not ELF64/AArch64")
+    if library["soname"] and library["soname"] != library["name"]:
+        errors.append(f"SONAME {library['soname']} differs from packaged filename")
+    segments = library["load_segments"]
+    if not segments:
+        errors.append("No PT_LOAD segments")
+    for segment in segments:
+        alignment = segment["alignment"]
+        if alignment < PAGE_SIZE or alignment & (alignment - 1):
+            errors.append(f"PT_LOAD alignment {alignment} is below 16 KiB or not a power of two")
+        if (segment["offset"] - segment["virtual_address"]) % PAGE_SIZE:
+            errors.append("PT_LOAD offset and virtual address are not congruent modulo 16 KiB")
+    return errors
+
+
+def run_tool(command, timeout=60):
+    completed = subprocess.run([str(value) for value in command], capture_output=True,
+                               text=True, errors="replace", timeout=timeout)
+    if completed.returncode:
+        details = (completed.stderr + "\n" + completed.stdout).strip()[-6000:]
+        raise RuntimeError(f"{Path(command[0]).name} exited {completed.returncode}: {details}")
+    return completed.stdout
+
+
+def tool_path(directory, name):
+    extensions = (".exe", ".bat", "") if os.name == "nt" else ("",)
+    for extension in extensions:
+        path = Path(directory) / (name + extension)
+        if path.is_file():
+            return path
+    raise FileNotFoundError(f"Android tool not found: {Path(directory) / name}")
+
+
+def readelf_path(args):
+    if args.readelf:
+        if not args.readelf.is_file():
+            raise FileNotFoundError("The specified llvm-readelf does not exist")
+        return args.readelf
+    if not args.ndk_root:
+        raise ValueError("Supply --ndk-root or --readelf (ANDROID_NDK_HOME is also accepted)")
+    candidates = sorted(args.ndk_root.glob("toolchains/llvm/prebuilt/*/bin/llvm-readelf*"))
+    for path in candidates:
+        if path.name in ("llvm-readelf", "llvm-readelf.exe") and path.is_file():
+            return path
+    raise FileNotFoundError("NDK llvm-readelf was not found")
+
+
+def self_test():
+    metadata = parse_badging("package: name='org.aspiaplus.client' versionCode='20702001' "
+                             "versionName='2.7.2-mobile.1'\n"
+                             "sdkVersion:'31'\ntargetSdkVersion:'36'\n"
+                             "native-code: 'arm64-v8a'\n")
+    assert metadata == {"package": "org.aspiaplus.client", "version_code": 20702001,
+                        "version_name": "2.7.2-mobile.1", "min_sdk": 31, "target_sdk": 36,
+                        "native_abis": ["arm64-v8a"], "debuggable": False}
+    assert parse_badging("application-debuggable\n")["debuggable"] is True
+    fingerprint = "ab" * 32
+    signing = parse_signatures("Verified using v2 scheme (APK Signature Scheme v2): true\n"
+                               f"Signer #1 certificate SHA-256 digest: {fingerprint}\n")
+    assert signing["certificate_sha256"] == [fingerprint] and signing["schemes"]["v2"]
+    library = parse_elf("  Class: ELF64\n  Machine: AArch64\n"
+        "  LOAD 0x000000 0x0000000000000000 0x0000000000000000 0x400 0x400 R E 0x4000\n"
+        "  0x000000000000000e (SONAME) Library soname: [libfixture.so]\n"
+        "  0x0000000000000001 (NEEDED) Shared library: [libc.so]\n")
+    library["name"] = "libfixture.so"
+    assert library["needed"] == ["libc.so"] and not native_errors(library)
+    library["load_segments"][0]["alignment"] = 4096
+    assert native_errors(library)
+    print(json.dumps({"passed": True, "scope": "checker parser fixtures only"}))
+    return 0
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--apk", type=Path)
+    parser.add_argument("--expected-cert-sha256")
+    parser.add_argument("--sdk-root", type=Path,
+                        default=os.environ.get("ANDROID_SDK_ROOT") or os.environ.get("ANDROID_HOME"))
+    parser.add_argument("--ndk-root", type=Path, default=os.environ.get("ANDROID_NDK_HOME"))
+    parser.add_argument("--build-tools-version", default="36.0.0")
+    parser.add_argument("--readelf", type=Path)
+    parser.add_argument("--package", default="org.aspiaplus.client")
+    parser.add_argument("--version-name", default="2.7.2-mobile.1")
+    parser.add_argument("--version-code", type=int, default=20702001)
+    parser.add_argument("--min-sdk", type=int, default=31)
+    parser.add_argument("--target-sdk", type=int, default=36)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument("--self-test", action="store_true")
+    args = parser.parse_args()
+    if args.self_test:
+        return self_test()
+    if not args.apk or not args.expected_cert_sha256 or not args.sdk_root:
+        parser.error("--apk, --expected-cert-sha256 and --sdk-root are required")
+
+    report = {"passed": False, "scope": "APK package validation only; no device or remote-session test",
+              "apk": args.apk.name, "checks": [], "libraries": []}
+
+    def check(name, action):
+        try:
+            detail = action()
+            report["checks"].append({"name": name, "passed": True, "detail": detail})
+        except Exception as error:
+            report["checks"].append({"name": name, "passed": False, "error": str(error)})
+
+    try:
+        if not args.apk.is_file():
+            raise FileNotFoundError("The APK file does not exist")
+        expected_cert = normalize_fingerprint(args.expected_cert_sha256)
+        report["size_bytes"] = args.apk.stat().st_size
+        with args.apk.open("rb") as stream:
+            report["sha256"] = hashlib.file_digest(stream, "sha256").hexdigest()
+        sdk_root = Path(args.sdk_root)
+        build_tools = sdk_root / "build-tools" / args.build_tools_version
+        aapt = tool_path(build_tools, "aapt")
+        apksigner = tool_path(build_tools, "apksigner")
+        zipalign = tool_path(build_tools, "zipalign")
+        readelf = readelf_path(args)
+
+        def metadata_check():
+            metadata = parse_badging(run_tool([aapt, "dump", "badging", args.apk]))
+            report["metadata"] = metadata
+            expected = {"package": args.package, "version_name": args.version_name,
+                        "version_code": args.version_code, "min_sdk": args.min_sdk,
+                        "target_sdk": args.target_sdk, "native_abis": ["arm64-v8a"],
+                        "debuggable": False}
+            differences = {name: {"expected": value, "actual": metadata.get(name)}
+                           for name, value in expected.items() if metadata.get(name) != value}
+            if differences:
+                raise ValueError(json.dumps(differences, ensure_ascii=False))
+            return metadata
+
+        def signature_check():
+            signatures = parse_signatures(run_tool(
+                [apksigner, "verify", "--verbose", "--print-certs", "--min-sdk-version",
+                 args.min_sdk, args.apk]))
+            report["signature"] = signatures
+            if signatures["certificate_sha256"] != [expected_cert]:
+                raise ValueError("APK signer certificate differs from the expected single signer")
+            if not any(signatures["schemes"].get(name) for name in ("v2", "v3", "v3.1")):
+                raise ValueError("No verified APK Signature Scheme v2/v3 signature")
+            return signatures
+
+        check("manifest_and_abi", metadata_check)
+        check("release_signature", signature_check)
+        check("zipalign_16k", lambda: {
+            "verified": bool(run_tool([zipalign, "-c", "-P", "16", "-v", "4", args.apk]) is not None)})
+
+        with zipfile.ZipFile(args.apk) as archive, tempfile.TemporaryDirectory(prefix="aspia-apk-elf-") as temporary:
+            entries = archive.infolist()
+            names = [entry.filename for entry in entries]
+            duplicates = len(names) != len(set(names))
+            native_entries = [entry for entry in entries if entry.filename.startswith("lib/") and
+                              entry.filename.endswith(".so") and not entry.is_dir()]
+            abis = sorted({entry.filename.split("/")[1] for entry in native_entries})
+            filenames = {Path(entry.filename).name for entry in native_entries}
+            packaging_errors = []
+            if duplicates:
+                packaging_errors.append("Duplicate ZIP entries")
+            if any(len(Path(entry.filename).parts) != 3 for entry in native_entries):
+                packaging_errors.append("Native library is not directly inside lib/<abi>/")
+            if abis != ["arm64-v8a"]:
+                packaging_errors.append(f"Unexpected native ABI set: {abis}")
+            for name in ("libcrypto_3.so", "libssl_3.so"):
+                if name not in filenames:
+                    packaging_errors.append(f"Missing bundled {name}")
+            if not any("qopensslbackend" in name for name in filenames):
+                packaging_errors.append("Missing Qt OpenSSL TLS backend")
+            report["checks"].append({"name": "native_payload", "passed": not packaging_errors,
+                                     "errors": packaging_errors, "library_count": len(native_entries)})
+
+            work = []
+            for index, entry in enumerate(native_entries):
+                path = Path(temporary) / f"{index}.so"
+                # Never extract archive paths; only a numbered file in our private temporary dir.
+                with archive.open(entry) as source, path.open("wb") as target:
+                    while chunk := source.read(1024 * 1024):
+                        target.write(chunk)
+                work.append((entry.filename, path))
+
+            def inspect(item):
+                name, path = item
+                try:
+                    library = parse_elf(run_tool([readelf, "-W", "-h", "-l", "-d", path]))
+                    library.update({"path": name, "name": Path(name).name})
+                    library["errors"] = native_errors(library)
+                    library["missing_dependencies"] = sorted(
+                        set(library["needed"]) - filenames - ANDROID_SYSTEM_LIBS)
+                    if library["missing_dependencies"]:
+                        library["errors"].append("Unresolved non-system DT_NEEDED dependencies")
+                    library["passed"] = not library["errors"]
+                    return library
+                except Exception as error:
+                    return {"path": name, "name": Path(name).name, "passed": False, "errors": [str(error)]}
+
+            with ThreadPoolExecutor(max_workers=4) as pool:
+                report["libraries"] = list(pool.map(inspect, work))
+            sonames = [library.get("soname") for library in report["libraries"] if library.get("soname")]
+            duplicate_sonames = sorted({name for name in sonames if sonames.count(name) > 1})
+            native_passed = bool(report["libraries"]) and not duplicate_sonames and all(
+                library["passed"] for library in report["libraries"])
+            report["checks"].append({"name": "elf_16k_and_dependency_closure", "passed": native_passed,
+                                     "duplicate_sonames": duplicate_sonames})
+    except Exception as error:
+        report["checks"].append({"name": "checker_setup", "passed": False, "error": str(error)})
+
+    report["passed"] = bool(report["checks"]) and all(check["passed"] for check in report["checks"])
+    output = json.dumps(report, ensure_ascii=False, indent=2) + "\n"
+    if args.output:
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text(output, encoding="utf-8")
+    print(output, end="")
+    return 0 if report["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
