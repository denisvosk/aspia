+#include "proto/router_legacy_host.h"
+
+namespace {
+LegacyRouterAdapter::Request connectionRequest(qint64 id = 42)
+{
+    proto::router::ClientToRouter message;
+    message.mutable_connection_request()->set_request_id(id);
+    message.mutable_connection_request()->set_host_id(123456789);
+    return *LegacyRouterAdapter::request(serialize(message));
+}
+
+LegacyRouterAdapter::Request statusRequest()
+{
+    proto::router::ClientToRouter message;
+    message.mutable_check_host_status()->set_request_id(45);
+    message.mutable_check_host_status()->set_host_id(123456789);
+    return *LegacyRouterAdapter::request(serialize(message));
+}
+} // namespace
+
+TEST(LegacyRouterAdapterTest, ConnectionRequestUsesFixed64OldWireField)
+{
+    auto request = connectionRequest();
+    EXPECT_EQ(request.kind, LegacyRouterAdapter::Kind::CONNECTION);
+    EXPECT_EQ(request.id, 42);
+    // PeerToRouter.connection_request tag1 -> ConnectionRequest.fixed64 host_id tag1.
+    EXPECT_EQ(request.payload.toHex(), QByteArray("0a090915cd5b0700000000"));
+}
+
+TEST(LegacyRouterAdapterTest, PresenceRequestUsesOldFieldFour)
+{
+    EXPECT_EQ(statusRequest().payload.toHex(), QByteArray("22090915cd5b0700000000"));
+}
+
+TEST(LegacyRouterAdapterTest, RejectsEmptyMalformedAndManagementRequests)
+{
+    EXPECT_FALSE(LegacyRouterAdapter::request({}));
+    EXPECT_FALSE(LegacyRouterAdapter::request(QByteArray::fromHex("ff")));
+    proto::router::ClientToRouter message;
+    message.mutable_change_password_request()->set_request_id(12);
+    EXPECT_FALSE(LegacyRouterAdapter::request(serialize(message)));
+    message.Clear();
+    message.mutable_connection_request()->set_request_id(12);
+    EXPECT_FALSE(LegacyRouterAdapter::request(serialize(message)));
+}
+
+TEST(LegacyRouterAdapterTest, OfflineIsNotDeletedAndVersionRemainsUnknown)
+{
+    // RouterToPeer.host_status (tag3), HostStatus.STATUS_OFFLINE (1).
+    const auto reply = LegacyRouterAdapter::reply(statusRequest(), QByteArray::fromHex("1a020801"));
+    ASSERT_TRUE(reply);
+    EXPECT_EQ(reply->host_status().request_id(), 45);
+    EXPECT_EQ(reply->host_status().error_code(), proto::router::kErrorHostOffline);
+    EXPECT_FALSE(reply->host_status().has_version());
+}
+
+TEST(LegacyRouterAdapterTest, OnlineAndUnknownMapWithoutInventedHardwareData)
+{
+    auto online = LegacyRouterAdapter::reply(statusRequest(), QByteArray::fromHex("1a020802"));
+    ASSERT_TRUE(online);
+    EXPECT_EQ(online->host_status().error_code(), proto::router::kErrorOk);
+    auto unknown = LegacyRouterAdapter::reply(statusRequest(), QByteArray::fromHex("1a00"));
+    ASSERT_TRUE(unknown);
+    EXPECT_EQ(unknown->host_status().error_code(), proto::router::kErrorInternalError);
+}
+
+TEST(LegacyRouterAdapterTest, RejectsMisorderedAndUnsolicitedReplyTypes)
+{
+    EXPECT_FALSE(LegacyRouterAdapter::reply(connectionRequest(), QByteArray::fromHex("1a020802")));
+    proto::router::legacy::RouterToPeer message;
+    message.mutable_host_id_response()->set_host_id(123456789);
+    EXPECT_FALSE(LegacyRouterAdapter::reply(statusRequest(), serialize(message)));
+}
+
+TEST(LegacyRouterAdapterTest, RelayOfferCarriesCredentialsAndSelectsLegacyHostTransport)
+{
+    proto::router::legacy::RouterToPeer message;
+    auto* offer = message.mutable_connection_offer();
+    offer->set_peer_role(proto::router::legacy::ConnectionOffer::CLIENT);
+    auto* relay = offer->mutable_relay();
+    relay->set_host("relay.example.test");
+    relay->set_port(8070);
+    relay->set_secret("test-only-secret");
+    relay->mutable_key()->set_key_id(7);
+    relay->mutable_key()->set_type(proto::router::RelayKey::TYPE_X25519);
+    relay->mutable_key()->set_encryption(proto::router::RelayKey::ENCRYPTION_CHACHA20_POLY1305);
+    relay->mutable_key()->set_public_key(std::string(32, 'k'));
+    relay->mutable_key()->set_iv(std::string(12, 'i'));
+    const auto reply = LegacyRouterAdapter::reply(connectionRequest(), serialize(message));
+    ASSERT_TRUE(reply);
+    EXPECT_EQ(reply->connection_offer().request_id(), 42);
+    EXPECT_EQ(reply->connection_offer().error_code(), proto::router::kErrorOk);
+    EXPECT_EQ(reply->connection_offer().relay().SerializeAsString(), relay->SerializeAsString());
+    EXPECT_TRUE(reply->connection_offer().peer_info().is_legacy());
+    EXPECT_FALSE(reply->connection_offer().has_stun_info());
+}
+
+TEST(LegacyRouterAdapterTest, RejectsHostRoleOfferAndInvalidRelayPort)
+{
+    proto::router::legacy::RouterToPeer message;
+    auto* offer = message.mutable_connection_offer();
+    offer->mutable_relay()->set_host("relay.example.test");
+    offer->mutable_relay()->set_port(70000);
+    offer->mutable_relay()->set_secret("secret");
+    offer->mutable_relay()->mutable_key()->set_key_id(7);
+    EXPECT_FALSE(LegacyRouterAdapter::reply(connectionRequest(), serialize(message)));
+    offer->set_peer_role(proto::router::legacy::ConnectionOffer::CLIENT);
+    EXPECT_FALSE(LegacyRouterAdapter::reply(connectionRequest(), serialize(message)));
+}
+
+TEST(LegacyRouterAdapterTest, RouterRefusalsRemainRefusals)
+{
+    for (const auto [old_error, expected] : {
+             std::pair{proto::router::legacy::ConnectionOffer::PEER_NOT_FOUND, proto::router::kErrorHostOffline},
+             std::pair{proto::router::legacy::ConnectionOffer::ACCESS_DENIED, proto::router::kErrorAccessDenied},
+             std::pair{proto::router::legacy::ConnectionOffer::KEY_POOL_EMPTY, proto::router::kErrorKeyPoolEmpty}})
+    {
+        proto::router::legacy::RouterToPeer message;
+        auto* offer = message.mutable_connection_offer();
+        offer->set_peer_role(proto::router::legacy::ConnectionOffer::CLIENT);
+        offer->set_error_code(old_error);
+        const auto reply = LegacyRouterAdapter::reply(connectionRequest(), serialize(message));
+        ASSERT_TRUE(reply);
+        EXPECT_EQ(reply->connection_offer().error_code(), expected);
+    }
+}
