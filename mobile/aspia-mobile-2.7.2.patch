+TEST_F(MobileBookDatabaseTest, RefreshReplacesWithoutDuplicatesAndRetainsProtectedSource)
+{
+    const QByteArray source = "{\"url\":\"https://example.test/book.aab\",\"password\":\"private\"}";
+    ASSERT_TRUE(database_.setMobileBookSource(source));
+    AabImporter::Book book;
+    ASSERT_EQ(AabImporter::read(goldenBook(), goldenPassword(), &book), Result::SUCCESS);
+    ASSERT_EQ(AabImporter::replace(database_, book), Result::SUCCESS);
+    ASSERT_EQ(AabImporter::replace(database_, book), Result::SUCCESS);
+    QList<LocalHostConfig> hosts;
+    ASSERT_EQ(database_.allLocalHosts(&hosts), Database::ReadResult::OK);
+    EXPECT_EQ(hosts.size(), 1);
+    QList<RouterConfig> routers;
+    ASSERT_EQ(database_.routerList(&routers), Database::ReadResult::OK);
+    ASSERT_EQ(routers.size(), 1);
+    EXPECT_TRUE(routers[0].isLegacy27());
+    EXPECT_EQ(routers[0].address(), "192.0.2.10:8060");
+    EXPECT_EQ(routers[0].password().toString(), "router-password");
+    EXPECT_EQ(hosts[0].routerId(), routers[0].routerId());
+    EXPECT_EQ(database_.displayName(), book.display_name);
+    ASSERT_TRUE(database_.mobileBookSource().has_value());
+    EXPECT_EQ(*database_.mobileBookSource(), source);
+
+    AabImporter::Book invalid = book;
+    invalid.display_name = "Should roll back";
+    invalid.hosts[0].setName(QString());
+    EXPECT_EQ(AabImporter::replace(database_, invalid), Result::DATABASE_ERROR);
+    hosts.clear();
+    ASSERT_EQ(database_.allLocalHosts(&hosts), Database::ReadResult::OK);
+    ASSERT_EQ(hosts.size(), 1);
+    EXPECT_EQ(hosts[0].name(), "TEST-PC");
+    EXPECT_EQ(database_.displayName(), book.display_name);
+    EXPECT_EQ(*database_.mobileBookSource(), source);
+    EXPECT_EQ(AabImporter::replace(database_, AabImporter::Book()), Result::EMPTY_BOOK);
+}
+
+TEST_F(MobileBookDatabaseTest, ProtectedSourceIsBoundToKeyAndAuthenticatedContext)
+{
+    EXPECT_EQ(database_.mobileBookSource(), std::optional<QByteArray>(QByteArray()));
+    const QByteArray source = "{\"password\":\"never-store-plain\"}";
+    ASSERT_TRUE(database_.setMobileBookSource(source));
+    SqlDatabase raw;
+    ASSERT_TRUE(raw.open(path_));
+    SqlQuery query(raw, "SELECT value FROM settings WHERE name='mobile_book_source_v1'");
+    ASSERT_EQ(query.next(), SqlQuery::StepResult::ROW);
+    QByteArray ciphertext = QByteArray::fromBase64(query.columnText(0).toLatin1());
+    ASSERT_EQ(query.next(), SqlQuery::StepResult::DONE); // Release the second connection read lock.
+    EXPECT_FALSE(ciphertext.contains("never-store-plain"));
+    EXPECT_FALSE(DataCryptor::instance().decrypt(ciphertext, "wrong-context").has_value());
+    DataCryptor::instance().setKey(SecureByteArray(Random::byteArray(32)));
+    EXPECT_FALSE(database_.mobileBookSource().has_value());
+    ASSERT_TRUE(database_.setMobileBookSource(QByteArray()));
+    EXPECT_EQ(database_.mobileBookSource(), std::optional<QByteArray>(QByteArray()));
+    ASSERT_TRUE(raw.exec("UPDATE settings SET value='not base64!' WHERE name='mobile_book_source_v1'"));
+    EXPECT_FALSE(database_.mobileBookSource().has_value());
+}
+
+TEST_F(MobileBookDatabaseTest, ProtectedSourceSurvivesMasterPasswordChange)
+{
+    const QString singleton_path = dir_.filePath("singleton.db3");
+    DatabaseTestPeer::setFilePath(singleton_path);
+    Database& db = Database::instance();
+    ASSERT_EQ(MasterPassword::setNew(SecureString(QString("OldPassword123"))),
+              MasterPassword::Result::SUCCESS);
+    const QByteArray source = "{\"password\":\"source-password\"}";
+    ASSERT_TRUE(db.setMobileBookSource(source));
+    ASSERT_EQ(MasterPassword::change(SecureString(QString("OldPassword123")),
+                                     SecureString(QString("NewPassword123"))),
+              MasterPassword::Result::SUCCESS);
+    ASSERT_TRUE(db.mobileBookSource().has_value());
+    EXPECT_EQ(*db.mobileBookSource(), source);
+    DataCryptor::instance().setKey(SecureByteArray());
+    ASSERT_EQ(MasterPassword::unlock(SecureString(QString("NewPassword123"))),
+              MasterPassword::Result::SUCCESS);
+    EXPECT_EQ(*db.mobileBookSource(), source);
+    DatabaseTestPeer::setFilePath(singleton_path);
+}
