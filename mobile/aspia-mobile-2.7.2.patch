diff --git a/source/client/tests/legacy_router_interop_test.py b/source/client/tests/legacy_router_interop_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..5e5056fb017d18eb07c6c94e310d77b4eabce582
--- /dev/null
+++ b/source/client/tests/legacy_router_interop_test.py
@@ -0,0 +1,110 @@
+#!/usr/bin/env python3
+"""Run the production legacy client handshake against an isolated 2.7 Router.
+
+Pass extracted official aspia_router and built aspia_legacy_router_probe paths.
+Uses bubblewrap to redirect /etc and /var into a temporary fixture, not the host
+installation. The only listening address is 127.0.0.1:18060. All credentials are
+the generated synthetic admin/admin fixture account; no real host is contacted.
+"""
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+import argparse
+import json
+from pathlib import Path
+import shutil
+import socket
+import sqlite3
+import subprocess
+import tempfile
+import time
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--router", required=True, type=Path)
+    parser.add_argument("--probe", required=True, type=Path)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    if not shutil.which("bwrap"):
+        parser.error("bubblewrap is required to isolate the Router configuration and database")
+    cases = []
+    with tempfile.TemporaryDirectory(prefix="aspia-router-interop-") as directory:
+        directory = Path(directory)
+        etc = directory / "etc"
+        var = directory / "var"
+        etc.mkdir()
+        var.mkdir()
+        command = ["bwrap", "--die-with-parent", "--ro-bind", "/", "/",
+                   "--bind", str(etc), "/etc", "--bind", str(var), "/var",
+                   "--", str(args.router.resolve())]
+        generated = subprocess.run(command + ["--create-config"], capture_output=True,
+                                   timeout=20)
+        config_path = etc / "aspia" / "router.json"
+        db_path = var / "lib" / "aspia" / "router.db3"
+        if generated.returncode != 0 or not config_path.exists() or not db_path.exists():
+            raise RuntimeError("Unable to generate isolated Router configuration and database")
+        config = json.loads(config_path.read_text(encoding="utf-8"))
+        config.update({"Port": 18060, "ListenInterface": "127.0.0.1"})
+        for kind in ("Admin", "Client", "Host", "Relay"):
+            config[kind + "WhiteList"] = "127.0.0.1;"
+        config_path.write_text(json.dumps(config), encoding="utf-8")
+        del config
+
+        with (directory / "router.log").open("wb") as log:
+            router = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT)
+            try:
+                deadline = time.monotonic() + 10
+                while True:
+                    if router.poll() is not None:
+                        raise RuntimeError("Isolated Router terminated before listening")
+                    try:
+                        with socket.create_connection(("127.0.0.1", 18060), timeout=0.2):
+                            break
+                    except OSError:
+                        if time.monotonic() >= deadline:
+                            raise RuntimeError("Isolated Router did not start before deadline") from None
+                        time.sleep(0.1)
+
+                def run(name, flags=()):
+                    completed = subprocess.run([str(args.probe.resolve()), *flags],
+                                               capture_output=True, text=True, timeout=20)
+                    try:
+                        result = json.loads(completed.stdout.strip().splitlines()[-1])
+                    except (IndexError, json.JSONDecodeError):
+                        raise AssertionError(f"{name}: missing JSON; return={completed.returncode}; "
+                                             f"stderr={completed.stderr[-2000:]}") from None
+                    record = {"name": name, "passed": completed.returncode == 0 and
+                              result.get("passed") is True, "observed": result}
+                    cases.append(record)
+                    print(json.dumps(record), flush=True)
+
+                run("srp_and_encrypted_router_messages")
+                run("wrong_password_refused", ("--bad-password",))
+                with sqlite3.connect(db_path) as db:
+                    original = db.execute("SELECT sessions FROM users WHERE name=?", ("admin",)).fetchone()
+                    if original is None:
+                        raise RuntimeError("Generated synthetic account missing")
+                    db.execute("UPDATE users SET sessions=1 WHERE name=?", ("admin",))
+                try:
+                    run("operator_role_refused", ("--denied-role",))
+                finally:
+                    with sqlite3.connect(db_path) as db:
+                        db.execute("UPDATE users SET sessions=? WHERE name=?", (original[0], "admin"))
+                run("role_restored_reconnect")
+            finally:
+                router.terminate()
+                try:
+                    router.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    router.kill()
+                    router.wait(timeout=5)
+    result = {"passed": bool(cases) and all(case["passed"] for case in cases),
+              "case_count": len(cases), "cases": cases}
+    if args.output:
+        args.output.write_text(json.dumps(result, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"passed": result["passed"], "case_count": len(cases)}), flush=True)
+    return 0 if result["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/source/client/tests/legacy_router_probe.cc b/source/client/tests/legacy_router_probe.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7dbbe0ed90308976c3d25261996993da503be3cd
--- /dev/null
+++ b/source/client/tests/legacy_router_probe.cc
@@ -0,0 +1,117 @@
+// Standalone interoperability probe for an isolated official Aspia 2.7 Router.
+// It never connects outside loopback and uses synthetic test credentials only.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <QCoreApplication>
+#include <QTimer>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <iostream>
+
+#include "base/logging.h"
+#include "base/net/tcp_channel_legacy.h"
+#include "base/peer/client_authenticator_legacy.h"
+#include "base/serialization.h"
+#include "base/threading/asio_event_dispatcher.h"
+#include "client/legacy_router_adapter.h"
+#include "proto/key_exchange.h"
+#include "proto/router_constants.h"
+
+int main(int argc, char** argv)
+{
+    LoggingSettings settings;
+    settings.min_log_level = LOG_WARNING;
+    ScopedLogging logging(settings);
+    QCoreApplication::setEventDispatcher(new AsioEventDispatcher());
+    QCoreApplication app(argc, argv);
+    const bool bad_password = app.arguments().contains("--bad-password");
+    const bool denied_role = app.arguments().contains("--denied-role");
+
+    QJsonObject result;
+    bool done = false;
+    auto finish = [&](bool passed)
+    {
+        if (done)
+            return;
+        done = true;
+        result.insert("passed", passed);
+        std::cout << QJsonDocument(result).toJson(QJsonDocument::Compact).constData() << std::endl;
+        app.exit(passed ? 0 : 1);
+    };
+
+    auto* authenticator = new ClientAuthenticatorLegacy();
+    authenticator->setIdentify(proto::key_exchange::IDENTIFY_SRP);
+    authenticator->setSessionType(2); // Actual old Router operator role, never admin.
+    authenticator->setUserName("admin");
+    authenticator->setPassword(SecureString(QString(bad_password ? "wrong-test-password" : "admin")));
+    TcpChannelLegacy channel(authenticator);
+    std::optional<LegacyRouterAdapter::Request> pending;
+    int stage = 0;
+    QObject::connect(&channel, &TcpChannel::sig_authenticated, &app, [&]()
+    {
+        result.insert("authenticated", true);
+        result.insert("peer_version", channel.peerVersion().toString());
+        if (bad_password || denied_role || channel.peerVersion().majorVersion() != 2)
+        {
+            finish(false);
+            return;
+        }
+        channel.setPaused(false);
+        proto::router::ClientToRouter request;
+        request.mutable_check_host_status()->set_request_id(101);
+        request.mutable_check_host_status()->set_host_id(123456789);
+        pending = LegacyRouterAdapter::request(serialize(request));
+        channel.send(0, pending->payload);
+    });
+    QObject::connect(&channel, &TcpChannel::sig_messageReceived, &app,
+        [&](quint8 channel_id, const QByteArray& data)
+    {
+        if (channel_id != 0 || !pending)
+        {
+            finish(false);
+            return;
+        }
+        const auto reply = LegacyRouterAdapter::reply(*pending, data);
+        if (!reply)
+        {
+            finish(false);
+            return;
+        }
+        if (stage == 0)
+        {
+            result.insert("presence", QString::fromStdString(reply->host_status().error_code()));
+            if (reply->host_status().request_id() != 101 ||
+                reply->host_status().error_code() != proto::router::kErrorHostOffline)
+            {
+                finish(false);
+                return;
+            }
+            stage = 1;
+            proto::router::ClientToRouter request;
+            request.mutable_connection_request()->set_request_id(102);
+            request.mutable_connection_request()->set_host_id(123456789);
+            pending = LegacyRouterAdapter::request(serialize(request));
+            channel.send(0, pending->payload);
+        }
+        else
+        {
+            result.insert("connection", QString::fromStdString(reply->connection_offer().error_code()));
+            finish(reply->connection_offer().request_id() == 102 &&
+                   reply->connection_offer().error_code() == proto::router::kErrorHostOffline);
+        }
+    });
+    QObject::connect(&channel, &TcpChannel::sig_errorOccurred, &app, [&](TcpChannel::ErrorCode error)
+    {
+        result.insert("error", TcpChannel::errorToString(error));
+        const bool expected_password_refusal = bad_password &&
+            (error == TcpChannel::ErrorCode::ACCESS_DENIED || error == TcpChannel::ErrorCode::CRYPTO_ERROR);
+        const bool expected_role_refusal = denied_role && error == TcpChannel::ErrorCode::SESSION_DENIED;
+        finish(!result.contains("authenticated") && (expected_password_refusal || expected_role_refusal));
+    });
+    QTimer timer;
+    QObject::connect(&timer, &QTimer::timeout, &channel, [&]() { channel.tick(Clock::now()); });
+    timer.start(1000);
+    QTimer::singleShot(15000, &app, [&]() { result.insert("timeout", true); finish(false); });
+    QTimer::singleShot(0, &channel, [&]() { channel.connectTo("127.0.0.1", 18060, Seconds(10)); });
+    return app.exec();
+}
diff --git a/source/client/tests/mobile_book_download_https_test.py b/source/client/tests/mobile_book_download_https_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..da6583d9f7211d67fbd97e1ddb027574c1d633af
--- /dev/null
+++ b/source/client/tests/mobile_book_download_https_test.py
@@ -0,0 +1,259 @@
+#!/usr/bin/env python3
+"""Real TLS/network checks for MobileBookDownload; no production servers or books.
+
+Pass the path of the native mobile_book_download_probe executable. Certificates,
+keys and test data are generated in a temporary directory and removed on exit.
+The server binds only to 127.0.0.1 and credentials are synthetic constants.
+"""
+# SPDX-License-Identifier: GPL-3.0-or-later
+
+import argparse
+import base64
+import hashlib
+import http.server
+import json
+import os
+from pathlib import Path
+import socket
+import ssl
+import subprocess
+import tempfile
+import threading
+import time
+
+
+MAX_SIZE = 16 * 1024 * 1024
+PAYLOAD = b"synthetic encrypted book fixture\x00\xff\r\n" * 97
+AUTH = "Basic " + base64.b64encode(b"fixture-user:fixture-password").decode("ascii")
+ETAG = '"fixture-book-v1"'
+
+
+def certificate(directory):
+    """Create an ephemeral CA and localhost server certificate using OpenSSL."""
+    directory = Path(directory)
+    commands = [
+        ["openssl", "req", "-x509", "-newkey", "rsa:2048", "-nodes", "-sha256",
+         "-days", "1", "-subj", "/CN=Aspia synthetic fixture CA",
+         "-addext", "basicConstraints=critical,CA:TRUE",
+         "-keyout", str(directory / "ca.key"), "-out", str(directory / "ca.crt")],
+        ["openssl", "req", "-newkey", "rsa:2048", "-nodes", "-sha256",
+         "-subj", "/CN=localhost", "-keyout", str(directory / "server.key"),
+         "-out", str(directory / "server.csr")],
+        ["openssl", "x509", "-req", "-sha256", "-days", "1",
+         "-in", str(directory / "server.csr"), "-CA", str(directory / "ca.crt"),
+         "-CAkey", str(directory / "ca.key"), "-CAcreateserial",
+         "-extfile", str(directory / "server.ext"), "-out", str(directory / "server.crt")],
+    ]
+    (directory / "server.ext").write_text(
+        "basicConstraints=critical,CA:FALSE\n"
+        "keyUsage=critical,digitalSignature,keyEncipherment\n"
+        "extendedKeyUsage=serverAuth\n"
+        "subjectAltName=DNS:localhost,IP:127.0.0.1\n", encoding="ascii")
+    for command in commands:
+        subprocess.run(command, check=True, stdout=subprocess.DEVNULL,
+                       stderr=subprocess.DEVNULL, timeout=20)
+    return directory / "ca.crt", directory / "server.crt", directory / "server.key"
+
+
+class Server(http.server.ThreadingHTTPServer):
+    daemon_threads = True
+    request_queue_size = 16
+
+    def __init__(self):
+        super().__init__(("127.0.0.1", 0), Handler)
+        self.records = []
+        self.records_lock = threading.Lock()
+        self.stop_waiting = threading.Event()
+
+
+class Handler(http.server.BaseHTTPRequestHandler):
+    protocol_version = "HTTP/1.1"
+
+    def log_message(self, *_):
+        pass
+
+    def respond(self, status, data=b"", **headers):
+        self.send_response(status)
+        self.send_header("Content-Length", str(len(data)))
+        self.send_header("Connection", "close")
+        for key, value in headers.items():
+            self.send_header(key.replace("_", "-"), value)
+        self.end_headers()
+        if data:
+            self.wfile.write(data)
+            self.wfile.flush()
+        self.close_connection = True
+
+    def do_GET(self):
+        with self.server.records_lock:
+            self.server.records.append({
+                "path": self.path,
+                "authenticated": self.headers.get("Authorization") == AUTH,
+                "if_none_match": self.headers.get("If-None-Match"),
+                "cookie": self.headers.get("Cookie"),
+            })
+        try:
+            self.handle_case()
+        except (BrokenPipeError, ConnectionResetError, ssl.SSLError, OSError):
+            # An intentional client refusal aborts its socket before the server finishes writing.
+            self.close_connection = True
+
+    def handle_case(self):
+        if self.headers.get("Authorization") != AUTH:
+            self.respond(401, b"fixture authentication missing")
+            return
+        if self.path == "/valid":
+            self.respond(200, PAYLOAD, ETag=ETAG, Set_Cookie="fixture=must-not-be-reused")
+        elif self.path == "/auth401":
+            self.respond(401, b"denied", WWW_Authenticate='Basic realm="fixture"')
+        elif self.path == "/auth403":
+            self.respond(403, b"denied")
+        elif self.path == "/redirect":
+            self.respond(302, b"redirect", Location=f"https://localhost:{self.server.server_port}/trap")
+        elif self.path == "/trap":
+            self.respond(200, b"redirect was incorrectly followed")
+        elif self.path == "/declared-large":
+            self.send_response(200)
+            self.send_header("Content-Length", str(MAX_SIZE + 1))
+            self.send_header("Connection", "close")
+            self.end_headers()
+            self.wfile.flush()
+            self.close_connection = True
+        elif self.path == "/chunked-large":
+            self.send_response(200)
+            self.send_header("Transfer-Encoding", "chunked")
+            self.send_header("Connection", "close")
+            self.end_headers()
+            chunk = b"x" * (64 * 1024)
+            for _ in range(MAX_SIZE // len(chunk) + 1):
+                self.wfile.write(f"{len(chunk):x}\r\n".encode("ascii") + chunk + b"\r\n")
+            self.wfile.write(b"0\r\n\r\n")
+            self.wfile.flush()
+            self.close_connection = True
+        elif self.path == "/exact-limit":
+            self.respond(200, b"x" * MAX_SIZE)
+        elif self.path == "/truncated":
+            self.send_response(200)
+            self.send_header("Content-Length", "1024")
+            self.send_header("Connection", "close")
+            self.end_headers()
+            self.wfile.write(b"partial")
+            self.wfile.flush()
+            self.connection.shutdown(socket.SHUT_RDWR)
+            self.close_connection = True
+        elif self.path == "/not-modified":
+            self.respond(304, ETag=ETAG)
+        elif self.path == "/http500":
+            self.respond(500, b"synthetic server failure")
+        elif self.path == "/http204":
+            self.respond(204)
+        elif self.path in ("/cancel", "/stall"):
+            self.server.stop_waiting.wait(36)
+            self.close_connection = True
+        else:
+            self.respond(404)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--probe", required=True, type=Path)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    cases = []
+    with tempfile.TemporaryDirectory(prefix="aspia-download-fixture-") as directory:
+        ca, crt, key = certificate(directory)
+        server = Server()
+        context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
+        context.minimum_version = ssl.TLSVersion.TLSv1_2
+        context.load_cert_chain(crt, key)
+        server.socket = context.wrap_socket(server.socket, server_side=True)
+        thread = threading.Thread(target=server.serve_forever, daemon=True)
+        thread.start()
+        origin = f"https://localhost:{server.server_port}"
+
+        def run(name, path, expected, *, trusted=True, extra=(), payload=None,
+                request_expected=True, status=None):
+            with server.records_lock:
+                before = len(server.records)
+            url = path if "://" in path else origin + path
+            command = [str(args.probe.resolve()), "--url", url]
+            if trusted:
+                command += ["--ca-file", str(ca)]
+            command += list(extra)
+            started = time.monotonic()
+            completed = subprocess.run(command, capture_output=True, text=True, timeout=45,
+                                       env={**os.environ, "NO_PROXY": "localhost,127.0.0.1"})
+            try:
+                result = json.loads(completed.stdout.strip().splitlines()[-1])
+            except (IndexError, json.JSONDecodeError):
+                raise AssertionError(f"{name}: no JSON result; return={completed.returncode}; "
+                                     f"stderr={completed.stderr[-2000:]}") from None
+            with server.records_lock:
+                requests = server.records[before:]
+            errors = []
+            if completed.returncode != 0:
+                errors.append(f"probe return {completed.returncode}")
+            allowed_results = expected if isinstance(expected, tuple) else (expected,)
+            if result.get("result") not in allowed_results:
+                errors.append(f"expected {expected}, received {result.get('result')}")
+            if result.get("completion_count") != 1:
+                errors.append("completion was not single-shot")
+            if status is not None and result.get("http_status") != status:
+                errors.append(f"unexpected HTTP status {result.get('http_status')}")
+            if payload is not None:
+                if result.get("bytes") != len(payload) or result.get("sha256") != hashlib.sha256(payload).hexdigest():
+                    errors.append("downloaded payload differs")
+            elif result.get("bytes") != 0:
+                errors.append("failed/canceled request exposed a partial payload")
+            if request_expected:
+                if len(requests) != 1 or not all(r["authenticated"] for r in requests):
+                    errors.append("unexpected request count or authentication")
+                if any(r["cookie"] is not None for r in requests):
+                    errors.append("unexpected cookie")
+            elif requests:
+                errors.append("invalid/untrusted source received an HTTP request")
+            if any(r["path"] == "/trap" for r in requests):
+                errors.append("redirect followed, credentials could leak")
+            record = {"name": name, "passed": not errors, "seconds": round(time.monotonic() - started, 3),
+                      "observed": result, "errors": errors}
+            cases.append(record)
+            print(json.dumps({"name": name, "passed": not errors, "result": result.get("result"),
+                              "errors": errors}), flush=True)
+
+        try:
+            run("authenticated_https", "/valid", "SUCCESS", payload=PAYLOAD, status=200)
+            run("credentials_401", "/auth401", "AUTH_FAILED", status=401)
+            run("credentials_403", "/auth403", "AUTH_FAILED", status=403)
+            run("redirect_refused", "/redirect", "REDIRECT", status=302)
+            run("declared_size_limit", "/declared-large", "TOO_LARGE", status=200)
+            run("streamed_size_limit", "/chunked-large", "TOO_LARGE", status=200)
+            run("exact_size_limit", "/exact-limit", "SUCCESS", payload=b"x" * MAX_SIZE, status=200)
+            # Qt TLS backends may report a truncated HTTP body as a transport error or wait for
+            # the bounded transfer timeout. Neither may expose partial bytes as a successful book.
+            run("truncated_response", "/truncated", ("NETWORK_ERROR", "TIMED_OUT"), status=200)
+            run("server_failure", "/http500", "HTTP_ERROR", status=500)
+            run("no_content", "/http204", "HTTP_ERROR", status=204)
+            run("unsolicited_304", "/not-modified", "REDIRECT", status=304)
+            run("conditional_304", "/not-modified", "UNCHANGED", extra=("--etag", ETAG), status=304)
+            run("certificate_refused", "/valid", "TLS_FAILED", trusted=False, request_expected=False)
+            run("http_refused", origin.replace("https://", "http://") + "/valid", "INVALID_SOURCE",
+                request_expected=False)
+            run("url_credentials_refused", origin.replace("https://", "https://test:test@") + "/valid",
+                "INVALID_SOURCE", request_expected=False)
+            run("url_fragment_refused", "/valid#fragment", "INVALID_SOURCE", request_expected=False)
+            run("cancel", "/cancel", "CANCELED", extra=("--cancel-after-ms", "250"))
+            run("transfer_timeout", "/stall", "TIMED_OUT")
+        finally:
+            server.stop_waiting.set()
+            server.shutdown()
+            server.server_close()
+            thread.join(timeout=2)
+    summary = {"passed": all(case["passed"] for case in cases), "case_count": len(cases), "cases": cases}
+    if args.output:
+        args.output.write_text(json.dumps(summary, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"passed": summary["passed"], "case_count": len(cases)}), flush=True)
+    return 0 if summary["passed"] else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/source/client/tests/mobile_book_download_probe.cc b/source/client/tests/mobile_book_download_probe.cc
new file mode 100644
index 0000000000000000000000000000000000000000..19df7ff2316f7fd3b1a652336ffc3af201637d62
--- /dev/null
+++ b/source/client/tests/mobile_book_download_probe.cc
@@ -0,0 +1,97 @@
+// Exercises the production downloader against an isolated HTTPS fixture.
+// All credentials are synthetic and all connections are restricted to loopback.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include <QCoreApplication>
+#include <QCryptographicHash>
+#include <QFile>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMetaEnum>
+#include <QSslCertificate>
+#include <QSslConfiguration>
+#include <QSslSocket>
+#include <QTimer>
+#include <iostream>
+
+#include "client/mobile_book_download.h"
+
+int main(int argc, char** argv)
+{
+    QCoreApplication app(argc, argv);
+    const QStringList args = app.arguments();
+    auto option = [&args](const QString& name) -> QString
+    {
+        const qsizetype index = args.indexOf(name);
+        return index >= 0 && index + 1 < args.size() ? args.at(index + 1) : QString();
+    };
+    const QUrl url(option("--url"), QUrl::StrictMode);
+    if (url.host() != "localhost" && url.host() != "127.0.0.1")
+    {
+        std::cerr << "Only loopback fixture URLs are permitted.\n";
+        return 2;
+    }
+
+    if (args.contains("--disable-tls") && !QSslSocket::setActiveBackend("cert-only"))
+    {
+        std::cerr << "The cert-only test backend is unavailable.\n";
+        return 2;
+    }
+
+    const QString ca_path = option("--ca-file");
+    if (!ca_path.isEmpty())
+    {
+        QFile ca_file(ca_path);
+        if (!ca_file.open(QIODevice::ReadOnly))
+            return 2;
+        const QList<QSslCertificate> certificates = QSslCertificate::fromData(ca_file.readAll());
+        if (certificates.isEmpty())
+            return 2;
+        QSslConfiguration configuration = QSslConfiguration::defaultConfiguration();
+        auto trusted = configuration.caCertificates();
+        trusted.append(certificates);
+        configuration.setCaCertificates(trusted);
+        QSslConfiguration::setDefaultConfiguration(configuration);
+    }
+
+    MobileBookDownload download;
+    QJsonObject result;
+    int completion_count = 0;
+    QObject::connect(&download, &MobileBookDownload::sig_finished, &app,
+        [&](MobileBookDownload::Result state, const QByteArray& data,
+            const QByteArray& etag, int status)
+    {
+        ++completion_count;
+        if (completion_count != 1)
+            return;
+        const char* name = QMetaEnum::fromType<MobileBookDownload::Result>().valueToKey(
+            static_cast<int>(state));
+        result.insert("result", QString::fromLatin1(name ? name : "UNKNOWN"));
+        result.insert("bytes", data.size());
+        result.insert("sha256", QString::fromLatin1(
+            QCryptographicHash::hash(data, QCryptographicHash::Sha256).toHex()));
+        result.insert("etag", QString::fromLatin1(etag));
+        result.insert("http_status", status);
+        // Give aborted replies a chance to emit their queued signals: finish must remain single-shot.
+        QTimer::singleShot(100, &app, [&]()
+        {
+            result.insert("completion_count", completion_count);
+            std::cout << QJsonDocument(result).toJson(QJsonDocument::Compact).constData() << std::endl;
+            app.exit(completion_count == 1 ? 0 : 1);
+        });
+    });
+    QTimer::singleShot(0, &download, [&]()
+    {
+        download.start(url, QStringLiteral("fixture-user"),
+            SecureString(QStringLiteral("fixture-password")), option("--etag").toUtf8());
+    });
+    const int cancel_after_ms = option("--cancel-after-ms").toInt();
+    if (cancel_after_ms > 0)
+        QTimer::singleShot(cancel_after_ms, &download, &MobileBookDownload::cancel);
+    QTimer::singleShot(40000, &app, [&]()
+    {
+        std::cerr << "Fixture probe deadline exceeded.\n";
+        app.exit(3);
+    });
+    return app.exec();
+}
diff --git a/source/client/tests/mobile_desktop_view_test.cc b/source/client/tests/mobile_desktop_view_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..31e43840e9d33e7455d7ddbf5e1298ff5e588edb
--- /dev/null
+++ b/source/client/tests/mobile_desktop_view_test.cc
@@ -0,0 +1,110 @@
+// Behavioral tests for the actual Android desktop view, rendered with Qt's offscreen platform.
+// SPDX-License-Identifier: GPL-3.0-or-later
+#include <QApplication>
+#include <QImage>
+#include <QTest>
+#include <QTouchEvent>
+#include <vector>
+
+#include "base/desktop/frame_aligned.h"
+#include "client/android/desktop_view.h"
+#include "proto/desktop_input.h"
+
+class MobileDesktopViewTest final : public QObject
+{
+    Q_OBJECT
+private:
+    static void initialize(DesktopView& view)
+    {
+        view.resize(300, 600);
+        auto frame = FrameAligned::create(QSize(1200, 600), 16);
+        QImage pixels(frame->frameData(), 1200, 600, frame->stride(), QImage::Format_RGB32);
+        pixels.fill(qRgb(220, 60, 40));
+        view.setFrame(SharedFrame(std::move(frame)));
+        view.show();
+        QTest::qWait(20);
+    }
+
+private slots:
+    void fitsPortraitAndLandscape()
+    {
+        DesktopView view;
+        initialize(view);
+        QImage portrait = view.grab().toImage();
+        QCOMPARE(portrait.pixelColor(10, 300), QColor(220, 60, 40));
+        QCOMPARE(portrait.pixelColor(10, 100), QColor(25, 25, 25));
+        view.resize(600, 300);
+        QTest::qWait(20);
+        QImage landscape = view.grab().toImage();
+        QCOMPARE(landscape.size(), QSize(600, 300));
+        QCOMPARE(landscape.pixelColor(10, 10), QColor(220, 60, 40));
+        QCOMPARE(landscape.pixelColor(590, 290), QColor(220, 60, 40));
+    }
+
+    void pinchZoomAndFitButton()
+    {
+        DesktopView view;
+        initialize(view);
+        auto* device = QTest::createTouchDevice();
+        QTest::touchEvent(&view, device).press(0, QPoint(120, 300), &view)
+                                      .press(1, QPoint(180, 300), &view);
+        QTest::touchEvent(&view, device).move(0, QPoint(70, 300), &view)
+                                      .move(1, QPoint(230, 300), &view);
+        QTest::touchEvent(&view, device).release(0, QPoint(70, 300), &view)
+                                      .release(1, QPoint(230, 300), &view);
+        QImage zoomed = view.grab().toImage();
+        QCOMPARE(zoomed.pixelColor(10, 150), QColor(220, 60, 40));
+        view.resetZoom();
+        QImage fitted = view.grab().toImage();
+        QCOMPARE(fitted.pixelColor(10, 150), QColor(25, 25, 25));
+        QCOMPARE(fitted.pixelColor(10, 300), QColor(220, 60, 40));
+    }
+
+    void cancelTouchReleasesRemoteDrag_data()
+    {
+        QTest::addColumn<bool>("disable_for_lock");
+        QTest::newRow("touch-canceled") << false;
+        QTest::newRow("disabled-for-lock") << true;
+    }
+
+    void cancelTouchReleasesRemoteDrag()
+    {
+        QFETCH(bool, disable_for_lock);
+        DesktopView view;
+        initialize(view);
+        std::vector<quint32> masks;
+        connect(&view, &DesktopView::sig_mouseEvent, &view,
+                [&](const proto::input::MouseEvent& event) { masks.push_back(event.mask()); });
+        auto* device = QTest::createTouchDevice();
+        QTest::touchEvent(&view, device).press(0, QPoint(150, 300), &view);
+        QTRY_VERIFY_WITH_TIMEOUT(!masks.empty(), 1200);
+        QCOMPARE(masks.back(), quint32(proto::input::MouseEvent::LEFT_BUTTON));
+        if (disable_for_lock)
+            view.setEnabled(false);
+        else
+        {
+            QTouchEvent cancel(QEvent::TouchCancel, device);
+            QApplication::sendEvent(&view, &cancel);
+        }
+        QCOMPARE(masks.back(), quint32(0));
+    }
+
+    void ctrlAltDeleteAlwaysReleasesModifiers()
+    {
+        DesktopView view;
+        std::vector<proto::input::KeyEvent> keys;
+        connect(&view, &DesktopView::sig_keyEvent, &view,
+                [&](const proto::input::KeyEvent& event) { keys.push_back(event); });
+        view.sendCtrlAltDelete();
+        QCOMPARE(keys.size(), size_t(6));
+        for (size_t i = 0; i < 3; ++i)
+        {
+            QVERIFY(keys[i].flags() & proto::input::KeyEvent::PRESSED);
+            QCOMPARE(keys[5 - i].usb_keycode(), keys[i].usb_keycode());
+            QCOMPARE(keys[5 - i].flags(), quint32(0));
+        }
+    }
+};
+
+QTEST_MAIN(MobileDesktopViewTest)
+#include "mobile_desktop_view_test.moc"
