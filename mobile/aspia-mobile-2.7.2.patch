+
+SecureString goldenPassword()
+{
+    return SecureString(QString::fromUtf8("BookPassword-Я1"));
+}
+
+QByteArray wrap(const QByteArray& data)
+{
+    proto::address_book::File file;
+    file.set_encryption_type(proto::address_book::ENCRYPTION_TYPE_NONE);
+    file.set_data(data.constData(), data.size());
+    return serialize(file);
+}
+
+QByteArray field(quint8 tag, const QByteArray& value)
+{
+    QByteArray result(1, static_cast<char>(tag));
+    quint32 size = value.size();
+    while (size >= 128)
+    {
+        result.append(static_cast<char>((size & 127) | 128));
+        size >>= 7;
+    }
+    result.append(static_cast<char>(size));
+    result.append(value);
+    return result;
+}
