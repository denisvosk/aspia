new file mode 100644
index 0000000000000000000000000000000000000000..824898dd2ca30a900d98a77d63320d0b77135a4f
--- /dev/null
+++ b/source/client/aab_book.cc
@@ -0,0 +1,431 @@
+// Aspia+ mobile address-book reader.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "client/aab_importer.h"
+
+#include <QFile>
+#include <google/protobuf/io/coded_stream.h>
+
+#include "base/build_config.h"
+#include "base/crypto/data_cryptor.h"
+#include "base/crypto/password_hash.h"
+#include "base/crypto/secure_byte_array.h"
+#include "base/crypto/secure_memory.h"
+#include "base/net/address.h"
+#include "base/peer/host_id.h"
+#include "client/database.h"
+#include "proto/address_book.h"
+
+namespace {
+
+using AabResult = AabImporter::Result;
+using CodedInput = google::protobuf::io::CodedInputStream;
+
+// Read only wire lengths first. A small protobuf can otherwise allocate millions of empty repeated
+// messages before the ordinary reader gets a chance to enforce the address-book limits.
+struct WireCounts
+{
+    int groups = 0;
+    int hosts = 0;
+    bool exceeded = false;
+};
+
+bool skipWireField(CodedInput& input, quint32 tag)
+{
+    uint64_t value;
+    quint32 length;
+    switch (tag & 7)
+    {
+        case 0: return input.ReadVarint64(&value);
+        case 1: return input.Skip(8);
+        case 2:
+            return input.ReadVarint32(&length) &&
+                   length <= static_cast<quint32>(AabImporter::kMaxFileSize) &&
+                   input.Skip(static_cast<int>(length));
+        case 5: return input.Skip(4);
+        default: return false; // This schema has no deprecated protobuf group fields.
+    }
+}
+
+bool checkGroupWire(QByteArrayView bytes, int depth, WireCounts* counts)
+{
+    if (depth > AabImporter::kMaxDepth || ++counts->groups > AabImporter::kMaxGroups)
+    {
+        counts->exceeded = true;
+        return false;
+    }
+
+    CodedInput input(reinterpret_cast<const quint8*>(bytes.data()), static_cast<int>(bytes.size()));
+    while (input.CurrentPosition() < bytes.size())
+    {
+        const quint32 tag = input.ReadTag();
+        if (!tag)
+            return false;
+        const quint32 field = tag >> 3;
+        if ((field == 3 || field == 4) && (tag & 7) == 2)
+        {
+            quint32 length;
+            if (!input.ReadVarint32(&length) || length > bytes.size() - input.CurrentPosition())
+                return false;
+            const QByteArrayView nested(bytes.data() + input.CurrentPosition(), length);
+            if (field == 3)
+            {
+                if (++counts->hosts > AabImporter::kMaxHosts)
+                {
+                    counts->exceeded = true;
+                    return false;
+                }
+            }
+            else if (!checkGroupWire(nested, depth + 1, counts))
+            {
+                return false;
+            }
+            if (!input.Skip(static_cast<int>(length)))
+                return false;
+        }
+        else if (!skipWireField(input, tag))
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+AabResult checkDataWire(const QByteArray& bytes)
+{
+    WireCounts counts;
+    CodedInput input(reinterpret_cast<const quint8*>(bytes.constData()), static_cast<int>(bytes.size()));
+    while (input.CurrentPosition() < bytes.size())
+    {
+        const quint32 tag = input.ReadTag();
+        if (!tag)
+            return AabResult::INVALID_FORMAT;
+        if ((tag >> 3) == 2 && (tag & 7) == 2)
+        {
+            quint32 length;
+            if (!input.ReadVarint32(&length) || length > bytes.size() - input.CurrentPosition())
+                return AabResult::INVALID_FORMAT;
+            if (!checkGroupWire(QByteArrayView(bytes.constData() + input.CurrentPosition(), length),
+                                0, &counts))
+            {
+                return counts.exceeded ? AabResult::TOO_LARGE : AabResult::INVALID_FORMAT;
+            }
+            if (!input.Skip(static_cast<int>(length)))
+                return AabResult::INVALID_FORMAT;
+        }
+        else if (!skipWireField(input, tag))
+        {
+            return AabResult::INVALID_FORMAT;
+        }
+    }
+    return AabResult::SUCCESS;
+}
+
+void wipeGroup(proto::address_book::ComputerGroup* group)
+{
+    if (group->has_config())
+    {
+        memZero(group->mutable_config()->mutable_username());
+        memZero(group->mutable_config()->mutable_password());
+    }
+    for (auto& computer : *group->mutable_computer())
+    {
+        memZero(computer.mutable_username());
+        memZero(computer.mutable_password());
+    }
+    for (auto& child : *group->mutable_computer_group())
+        wipeGroup(&child);
+}
+
+struct ProtoWiper
+{
+    proto::address_book::File file;
+    proto::address_book::Data data;
+    ~ProtoWiper()
+    {
+        memZero(file.mutable_data());
+        if (data.has_router())
+        {
+            memZero(data.mutable_router()->mutable_username());
+            memZero(data.mutable_router()->mutable_password());
+        }
+        if (data.has_root_group())
+            wipeGroup(data.mutable_root_group());
+    }
+};
+
+// Keep the explicit legacy port in the formatted address. Passing 8060 as Address's default would
+// omit it and a later v3 RouterConfig consumer would then supply the wrong default client port.
+QString legacyAddress(const std::string& host, quint32 port, quint16 default_port)
+{
+    if (host.empty() || host.size() > 1024 || port > 65535)
+        return QString();
+    const QString name = QString::fromStdString(host);
+    if (name.contains(QChar::Null))
+        return QString();
+    Address address(0);
+    address.setHost(name);
+    address.setPort(port ? static_cast<quint16>(port) : default_port);
+    return address.isValid() ? address.toString() : QString();
+}
+
+bool hasValidText(const QString& text, qsizetype maximum, bool allow_empty = true)
+{
+    return (allow_empty || !text.isEmpty()) && text.size() <= maximum && !text.contains(QChar::Null);
+}
+
+struct MobileCredentials
+{
+    QString username;
+    SecureString password;
+};
+
+bool stageGroup(const proto::address_book::ComputerGroup& source,
+                qint64 parent_id,
+                qint64 router_id,
+                const MobileCredentials& inherited,
+                int depth,
+                qint64* next_id,
+                qsizetype* credential_bytes,
+                AabImporter::Book* book)
+{
+    if (depth > AabImporter::kMaxDepth)
+        return false;
+
+    qint64 group_id = parent_id;
+    if (depth > 0)
+    {
+        LocalGroupConfig group;
+        group.setId((*next_id)--);
+        group.setParentId(parent_id);
+        group.setName(QString::fromStdString(source.name()));
+        group.setComment(QString::fromStdString(source.comment()));
+        if (!hasValidText(group.name(), LocalGroupConfig::kMaxNameLength, false) ||
+            !hasValidText(group.comment(), LocalGroupConfig::kMaxCommentLength))
+        {
+            return false;
+        }
+        group_id = group.id();
+        book->groups.append(std::move(group));
+    }
+
+    MobileCredentials credentials = inherited;
+    if (source.has_config() && !source.config().inherit().credentials())
+    {
+        const auto& config = source.config();
+        if (config.username().size() > 1024 || config.password().size() > 16384)
+            return false;
+        credentials.username = QString::fromStdString(config.username());
+        credentials.password = SecureString(QString::fromStdString(config.password()));
+    }
+
+    for (const auto& source_host : source.computer())
+    {
+        LocalHostConfig host;
+        host.setId((*next_id)--);
+        host.setGroupId(group_id);
+        host.setName(QString::fromStdString(source_host.name()));
+        host.setComment(QString::fromStdString(source_host.comment()));
+        host.setCreateTime(source_host.create_time());
+        host.setModifyTime(source_host.modify_time());
+        if (!hasValidText(host.name(), LocalHostConfig::kMaxNameLength, false) ||
+            !hasValidText(host.comment(), LocalHostConfig::kMaxCommentLength) ||
+            source_host.address().size() > 1024 || source_host.port() > 65535)
+        {
+            return false;
+        }
+
+        const QString raw_address = QString::fromStdString(source_host.address());
+        if (isHostId(raw_address))
+        {
+            if (!router_id)
+                return false;
+            host.setRouterId(router_id);
+            host.setAddress(raw_address);
+        }
+        else
+        {
+            host.setAddress(legacyAddress(source_host.address(), source_host.port(), kDefaultHostTcpPort));
+            if (host.address().isEmpty())
+                return false;
+        }
+
+        QString username;
+        SecureString password;
+        if (source_host.has_inherit() && source_host.inherit().credentials())
+        {
+            username = credentials.username;
+            password = credentials.password;
+        }
+        else
+        {
+            if (source_host.username().size() > 1024 || source_host.password().size() > 16384)
+                return false;
+            username = QString::fromStdString(source_host.username());
+            password = SecureString(QString::fromStdString(source_host.password()));
+        }
+
+        // Inherited credentials can expand a tiny input into a very large mobile database.
+        // Bound the expanded UTF-16 credentials as well as the original file and row counts.
+        *credential_bytes += (username.size() + password.size()) * sizeof(QChar);
+        if (*credential_bytes > AabImporter::kMaxExpandedCredentialBytes)
+            return false;
+
+        // An unsaved password is a legitimate desktop-book entry. Such a host prompts once on
+        // connection instead of importing half a credential pair that the mobile database rejects.
+        if (!username.isEmpty() && !password.isEmpty())
+        {
+            host.setUsername(username);
+            host.setPassword(password);
+        }
+        book->hosts.append(std::move(host));
+    }
+
+    for (const auto& child : source.computer_group())
+    {
+        if (!stageGroup(child, group_id, router_id, credentials, depth + 1, next_id, credential_bytes, book))
+            return false;
+    }
+    return true;
+}
+
+} // namespace
+
+AabImporter::Result AabImporter::read(const QByteArray& bytes,
+                                      const SecureString& password,
+                                      Book* book)
+{
+    if (!book)
+        return Result::INVALID_FORMAT;
+    *book = Book();
+    if (bytes.isEmpty())
+        return Result::INVALID_FORMAT;
+    if (bytes.size() > kMaxFileSize)
+        return Result::TOO_LARGE;
+
+    ProtoWiper proto;
+    CodedInput file_input(reinterpret_cast<const quint8*>(bytes.constData()),
+                          static_cast<int>(bytes.size()));
+    file_input.SetRecursionLimit(kMaxDepth + 16);
+    file_input.SetTotalBytesLimit(static_cast<int>(kMaxFileSize));
+    if (!proto.file.ParseFromCodedStream(&file_input) || !file_input.ConsumedEntireMessage())
+        return Result::INVALID_FORMAT;
+    if (proto.file.data().empty())
+        return Result::INVALID_FORMAT;
+
+    SecureByteArray plain;
+    Book staged;
+    switch (proto.file.encryption_type())
+    {
+        case proto::address_book::ENCRYPTION_TYPE_NONE:
+            plain = SecureByteArray(proto.file.data().data(), proto.file.data().size());
+            break;
+        case proto::address_book::ENCRYPTION_TYPE_CHACHA20_POLY1305:
+        {
+            if (proto.file.hashing_salt().empty() || proto.file.hashing_salt().size() > 1024 ||
+                proto.file.data().size() <= 28)
+            {
+                return Result::INVALID_FORMAT;
+            }
+            if (password.isEmpty())
+                return Result::PASSWORD_REQUIRED;
+            if (password.size() > 16384)
+                return Result::TOO_LARGE;
+            SecureByteArray key(PasswordHash::hash(PasswordHash::SCRYPT, password,
+                                  QByteArray::fromStdString(proto.file.hashing_salt())));
+            std::optional<QByteArray> decrypted =
+                DataCryptor(CipherType::CHACHA20_POLY1305, key).decrypt(proto.file.data());
+            if (!decrypted)
+                return Result::WRONG_PASSWORD;
+            plain = SecureByteArray(std::move(*decrypted));
+            staged.encrypted = true;
+            break;
+        }
+        default:
+            return Result::UNSUPPORTED_ENCRYPTION;
+    }
+
+    const Result wire_result = checkDataWire(plain.toByteArray());
+    if (wire_result != Result::SUCCESS)
+        return wire_result;
+    CodedInput data_input(reinterpret_cast<const quint8*>(plain.constData()),
+                          static_cast<int>(plain.size()));
+    data_input.SetRecursionLimit(kMaxDepth + 16);
+    data_input.SetTotalBytesLimit(static_cast<int>(kMaxFileSize));
+    if (!proto.data.ParseFromCodedStream(&data_input) || !data_input.ConsumedEntireMessage() ||
+        !proto.data.has_root_group())
+    {
+        return Result::INVALID_FORMAT;
+    }
+
+    staged.name = QString::fromStdString(proto.data.root_group().name());
+    staged.guid = QString::fromStdString(proto.data.guid());
+    staged.display_name = QString::fromStdString(proto.data.display_name());
+    if (!hasValidText(staged.name, 1024) || !hasValidText(staged.guid, 128) ||
+        !hasValidText(staged.display_name, 1024))
+    {
+        return Result::INVALID_RECORD;
+    }
+
+    qint64 next_id = -1;
+    qint64 router_id = 0;
+    if (proto.data.enable_router())
+    {
+        const auto& source = proto.data.router();
+        if (source.username().size() > 1024 || source.password().size() > 16384)
+            return Result::INVALID_RECORD;
+        RouterConfig router;
+        router_id = next_id--;
+        router.setRouterId(router_id);
+        router.setLegacy27(true);
+        router.setAddress(legacyAddress(source.address(), source.port(), 8060));
+        router.setDisplayName(staged.name.left(RouterConfig::kMaxNameLength));
+        router.setUsername(QString::fromStdString(source.username()));
+        router.setPassword(SecureString(QString::fromStdString(source.password())));
+        if (!router.isValid())
+            return Result::INVALID_RECORD;
+        staged.routers.append(std::move(router));
+    }
+
+    qsizetype credential_bytes = 0;
+    if (!stageGroup(proto.data.root_group(), 0, router_id, MobileCredentials(), 0, &next_id,
+                    &credential_bytes, &staged))
+    {
+        return credential_bytes > kMaxExpandedCredentialBytes ? Result::TOO_LARGE : Result::INVALID_RECORD;
+    }
+    if (staged.hosts.isEmpty())
+        return Result::EMPTY_BOOK;
+    *book = std::move(staged);
+    return Result::SUCCESS;
+}
+
+AabImporter::Result AabImporter::readFile(const QString& path,
+                                          const SecureString& password,
+                                          Book* book)
+{
+    if (book)
+        *book = Book();
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly))
+        return Result::FILE_ERROR;
+    if (file.size() > kMaxFileSize)
+        return Result::TOO_LARGE;
+    SecureByteArray bytes(file.read(kMaxFileSize + 1));
+    if (file.error() != QFileDevice::NoError)
+        return Result::FILE_ERROR;
+    if (!file.atEnd() || bytes.size() > kMaxFileSize)
+        return Result::TOO_LARGE;
+    return read(bytes.toByteArray(), password, book);
+}
+
+AabImporter::Result AabImporter::replace(Database& database, const Book& book)
+{
+    if (book.hosts.isEmpty())
+        return Result::EMPTY_BOOK;
+    if (!DataCryptor::instance().isValid())
+        return Result::DATABASE_ERROR;
+    if (book.hosts.size() > kMaxHosts || book.groups.size() > kMaxGroups || book.routers.size() > 1)
+        return Result::TOO_LARGE;
+    return database.import(book.routers, book.groups, book.hosts, {}, {}, book.display_name) ?
+        Result::SUCCESS : Result::DATABASE_ERROR;
+}
