diff --git a/source/client/android/mobile_book_manager.cc b/source/client/android/mobile_book_manager.cc
new file mode 100644
index 0000000000000000000000000000000000000000..8548bf2f5c143a6996cf09585285c335e2adeb65
--- /dev/null
+++ b/source/client/android/mobile_book_manager.cc
@@ -0,0 +1,325 @@
+// Aspia+ mobile address book. Distributed under GPL-3.0-or-later.
+#include "client/android/mobile_book_manager.h"
+
+#include <QCryptographicHash>
+#include <QDateTime>
+#include <QFile>
+#include <QFileDialog>
+#include <QJsonDocument>
+#include <QScopedValueRollback>
+#include <QTimer>
+#include <QVBoxLayout>
+
+#include "base/auto_qpointer.h"
+#include "client/aab_importer.h"
+#include "client/database.h"
+#include "client/mobile_book_download.h"
+#include "client/router_controller.h"
+#include "client/android/password_dialog.h"
+#include "common/android/dialog.h"
+#include "common/android/label.h"
+#include "common/android/line_edit.h"
+#include "common/android/message_dialog.h"
+
+namespace {
+QString importError(AabImporter::Result result)
+{
+    switch (result)
+    {
+        case AabImporter::Result::TOO_LARGE:
+            return QStringLiteral("Книга больше 16 МиБ. Текущий список сохранён.");
+        case AabImporter::Result::WRONG_PASSWORD:
+        case AabImporter::Result::PASSWORD_REQUIRED:
+            return QStringLiteral("Неверный пароль книги или файл повреждён. Текущий список сохранён.");
+        case AabImporter::Result::UNSUPPORTED_ENCRYPTION:
+            return QStringLiteral("Этот способ шифрования книги не поддерживается.");
+        case AabImporter::Result::EMPTY_BOOK:
+            return QStringLiteral("В книге нет компьютеров. Текущий список сохранён.");
+        default:
+            return QStringLiteral("Не удалось прочитать книгу Aspia .aab. Текущий список сохранён.");
+    }
+}
+}
+
+MobileBookManager::MobileBookManager(QWidget* parent) : QObject(parent), parent_(parent) {}
+
+bool MobileBookManager::loadSource(QJsonObject* source)
+{
+    auto value = Database::instance().mobileBookSource();
+    if (!value.has_value())
+    {
+        MessageDialog::info(parent_, QStringLiteral("Источник книги"),
+            QStringLiteral("Не удалось расшифровать настройки источника. Настройте его заново."));
+        return false;
+    }
+    if (value->isEmpty())
+    {
+        *source = {};
+        return true;
+    }
+    QJsonParseError error;
+    QJsonDocument document = QJsonDocument::fromJson(*value, &error);
+    value->fill('\0');
+    if (error.error != QJsonParseError::NoError || !document.isObject() ||
+        document.object().value("version").toInt() != 1)
+    {
+        MessageDialog::info(parent_, QStringLiteral("Источник книги"),
+            QStringLiteral("Настройки источника повреждены. Настройте его заново."));
+        return false;
+    }
+    *source = document.object();
+    return true;
+}
+
+bool MobileBookManager::saveSource(const QJsonObject& source)
+{
+    QByteArray bytes = QJsonDocument(source).toJson(QJsonDocument::Compact);
+    const bool saved = Database::instance().setMobileBookSource(bytes);
+    bytes.fill('\0');
+    if (!saved)
+        MessageDialog::info(parent_, QStringLiteral("Источник книги"),
+            QStringLiteral("Не удалось сохранить настройки источника на телефоне."));
+    return saved;
+}
+
+void MobileBookManager::importFile()
+{
+    if (busy_)
+        return;
+    QScopedValueRollback<bool> guard(busy_, true);
+    const QString path = QFileDialog::getOpenFileName(parent_, QStringLiteral("Импорт книги Aspia"),
+        {}, QStringLiteral("Книга Aspia (*.aab);;Все файлы (*)"));
+    if (path.isEmpty())
+        return;
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly))
+    {
+        MessageDialog::info(parent_, QStringLiteral("Импорт книги"),
+                            QStringLiteral("Не удалось открыть выбранный файл."));
+        return;
+    }
+    // Content providers may not report a size, so also bound the actual read.
+    QByteArray bytes = file.read(AabImporter::kMaxFileSize + 1);
+    if (bytes.size() > AabImporter::kMaxFileSize || !file.atEnd())
+    {
+        MessageDialog::info(parent_, QStringLiteral("Импорт книги"),
+                            importError(AabImporter::Result::TOO_LARGE));
+        return;
+    }
+    SecureString password;
+    QJsonObject source;
+    if (importData(bytes, &password, false, &source))
+    {
+        // An explicit local import severs the old refresh identity. Keep the endpoint, but ask
+        // before replacing this book with the server's copy and request its password again.
+        if (loadSource(&source) && !source.isEmpty())
+        {
+            for (const auto* key : { "etag", "book_guid", "book_password", "last_sync_utc", "sha256" })
+                source.remove(key);
+            saveSource(source);
+        }
+    }
+    bytes.fill('\0');
+}
+
+bool MobileBookManager::importData(const QByteArray& bytes, SecureString* password,
+                                   bool remote, QJsonObject* source)
+{
+    AabImporter::Book book;
+    auto result = AabImporter::read(bytes, *password, &book);
+    if (result == AabImporter::Result::PASSWORD_REQUIRED ||
+        result == AabImporter::Result::WRONG_PASSWORD)
+    {
+        AutoQPointer<PasswordDialog> prompt(new PasswordDialog(PasswordDialog::Mode::ENTER, parent_));
+        prompt->setTitle(QStringLiteral("Пароль адресной книги"));
+        prompt->setText(QStringLiteral("Введите пароль, которым защищён файл .aab в консоли."));
+        if (prompt->exec() != QDialog::Accepted)
+            return false;
+        *password = prompt->password();
+        result = AabImporter::read(bytes, *password, &book);
+    }
+    if (result != AabImporter::Result::SUCCESS)
+    {
+        MessageDialog::info(parent_, QStringLiteral("Импорт книги"), importError(result));
+        return false;
+    }
+    if (remote && !book.encrypted)
+    {
+        MessageDialog::info(parent_, QStringLiteral("Книга не зашифрована"),
+            QStringLiteral("Для загрузки с сервера сохраните книгу в консоли с паролем. "
+                           "Текущий список сохранён."));
+        return false;
+    }
+    const bool same_book = remote && !book.guid.isEmpty() &&
+                          source->value("book_guid").toString() == book.guid;
+    if (!same_book && !MessageDialog::confirm(parent_, QStringLiteral("Импорт книги"),
+        QStringLiteral("%1\nГрупп: %2 · Компьютеров: %3\n\nЗаменить список на телефоне этой книгой?")
+            .arg(book.name).arg(book.groups.size()).arg(book.hosts.size()), QStringLiteral("Импортировать")))
+        return false;
+
+    result = AabImporter::replace(Database::instance(), book);
+    if (result != AabImporter::Result::SUCCESS)
+    {
+        MessageDialog::info(parent_, QStringLiteral("Импорт книги"),
+            QStringLiteral("Не удалось сохранить книгу. Предыдущий список не изменён."));
+        return false;
+    }
+    if (remote)
+    {
+        source->insert("book_guid", book.guid);
+        source->insert("book_password", password->toString());
+        source->insert("sha256", QString::fromLatin1(
+            QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex()));
+        source->insert("last_sync_utc", QDateTime::currentDateTimeUtc().toString(Qt::ISODate));
+    }
+    RouterController::instance().reload();
+    emit sig_bookChanged();
+    MessageDialog::info(parent_, QStringLiteral("Книга обновлена"),
+        QStringLiteral("Групп: %1 · Компьютеров: %2\nНажмите на компьютер, чтобы подключиться.")
+            .arg(book.groups.size()).arg(book.hosts.size()));
+    return true;
+}
+
+void MobileBookManager::configureSource()
+{
+    if (busy_)
+        return;
+    QScopedValueRollback<bool> guard(busy_, true);
+    QJsonObject source;
+    // A damaged source may be replaced explicitly; it must never be used for a request.
+    loadSource(&source);
+    AutoQPointer<Dialog> dialog(new Dialog(parent_));
+    dialog->setTitle(QStringLiteral("Книга с сервера"));
+    dialog->setText(QStringLiteral("Один раз укажите ссылку и доступ к файлу. "
+                                  "Затем используйте «Обновить книгу»."));
+    auto* url = new LineEdit(dialog);
+    url->setLabel(QStringLiteral("HTTPS-ссылка на файл .aab"));
+    url->setInputMethodHints(Qt::ImhUrlCharactersOnly | Qt::ImhNoPredictiveText);
+    url->setText(source.value("url").toString());
+    auto* username = new LineEdit(dialog);
+    username->setLabel(QStringLiteral("Логин для скачивания"));
+    username->setText(source.value("username").toString());
+    auto* password = new LineEdit(dialog);
+    password->setLabel(QStringLiteral("Пароль для скачивания"));
+    password->setEchoMode(QLineEdit::Password);
+    password->setText(source.value("password").toString());
+    dialog->contentLayout()->addWidget(url);
+    dialog->contentLayout()->addWidget(username);
+    dialog->contentLayout()->addWidget(password);
+    auto* error = new Label({}, Label::Role::CAPTION, dialog);
+    error->setWordWrap(true);
+    dialog->contentLayout()->addWidget(error);
+    auto* cancel = dialog->addButton(QStringLiteral("Отмена"));
+    auto* save = dialog->addButton(QStringLiteral("Сохранить"), Button::Role::FILLED);
+    connect(cancel, &Button::clicked, dialog, &QDialog::reject);
+    connect(save, &Button::clicked, dialog, [&, url, username, password, error]()
+    {
+        if (!MobileBookDownload::isValidSource(QUrl(url->text().trimmed(), QUrl::StrictMode),
+                                               username->text(), SecureString(password->text())))
+        {
+            error->setText(QStringLiteral("Нужны HTTPS-ссылка на файл, логин и пароль. "
+                                          "Не указывайте пароль внутри ссылки."));
+            return;
+        }
+        dialog->accept();
+    });
+    if (dialog->exec() != QDialog::Accepted)
+        return;
+    const QString endpoint = QUrl(url->text().trimmed(), QUrl::StrictMode).toString(QUrl::FullyEncoded);
+    if (endpoint != source.value("url").toString() ||
+        username->text() != source.value("username").toString())
+        source = {};
+    source.insert("version", 1);
+    source.insert("url", endpoint);
+    source.insert("username", username->text());
+    source.insert("password", password->text());
+    password->clear();
+    if (saveSource(source))
+        QTimer::singleShot(0, this, &MobileBookManager::refresh);
+}
+
+void MobileBookManager::refresh()
+{
+    if (busy_)
+        return;
+    QJsonObject source;
+    if (!loadSource(&source))
+        return;
+    if (source.isEmpty())
+    {
+        configureSource();
+        return;
+    }
+    QScopedValueRollback<bool> guard(busy_, true);
+    AutoQPointer<Dialog> progress(new Dialog(parent_));
+    progress->setTitle(QStringLiteral("Обновление книги"));
+    progress->setText(QStringLiteral("Загружаю защищённую книгу…"));
+    auto* cancel = progress->addButton(QStringLiteral("Отмена"));
+    connect(cancel, &Button::clicked, progress, &QDialog::reject);
+    MobileBookDownload download;
+    auto result = MobileBookDownload::Result::CANCELED;
+    QByteArray bytes;
+    QByteArray etag;
+    int http_status = 0;
+    connect(&download, &MobileBookDownload::sig_finished, progress,
+        [&](MobileBookDownload::Result state, const QByteArray& data, const QByteArray& tag, int status)
+    {
+        result = state;
+        bytes = data;
+        etag = tag;
+        http_status = status;
+        progress->accept();
+    });
+    QTimer::singleShot(0, &download, [&]()
+    {
+        download.start(QUrl(source.value("url").toString(), QUrl::StrictMode),
+            source.value("username").toString(), SecureString(source.value("password").toString()));
+    });
+    progress->exec();
+    download.disconnect(progress);
+    download.cancel();
+    if (result == MobileBookDownload::Result::CANCELED)
+        return;
+    if (result == MobileBookDownload::Result::UNCHANGED)
+    {
+        MessageDialog::info(parent_, QStringLiteral("Книга актуальна"),
+            QStringLiteral("На сервере та же версия. Список компьютеров сохранён."));
+        return;
+    }
+    if (result == MobileBookDownload::Result::SUCCESS)
+    {
+        SecureString password(source.value("book_password").toString());
+        if (importData(bytes, &password, true, &source))
+        {
+            source.insert("etag", QString::fromLatin1(etag));
+            saveSource(source);
+        }
+        bytes.fill('\0');
+        return;
+    }
+    QString message;
+    switch (result)
+    {
+        case MobileBookDownload::Result::AUTH_FAILED:
+            message = QStringLiteral("Сервер отклонил логин или пароль для скачивания."); break;
+        case MobileBookDownload::Result::TLS_FAILED:
+            message = QStringLiteral("Не удалось проверить HTTPS-сертификат сервера."); break;
+        case MobileBookDownload::Result::TLS_UNAVAILABLE:
+            message = QStringLiteral("Не загрузился модуль HTTPS приложения. "
+                                     "Используйте импорт .aab из файла и сообщите версию приложения."); break;
+        case MobileBookDownload::Result::TOO_LARGE:
+            message = QStringLiteral("Файл больше 16 МиБ."); break;
+        case MobileBookDownload::Result::TIMED_OUT:
+            message = QStringLiteral("Сервер не ответил вовремя. Повторите обновление позже."); break;
+        case MobileBookDownload::Result::REDIRECT:
+            message = QStringLiteral("Сервер перенаправляет запрос. Укажите конечную HTTPS-ссылку на файл."); break;
+        case MobileBookDownload::Result::INVALID_SOURCE:
+            message = QStringLiteral("Проверьте HTTPS-ссылку, логин и пароль в источнике книги."); break;
+        case MobileBookDownload::Result::HTTP_ERROR:
+            message = QStringLiteral("Сервер вернул HTTP %1. Проверьте ссылку на книгу.").arg(http_status); break;
+        default:
+            message = QStringLiteral("Сервер недоступен. Проверьте интернет и повторите позже."); break;
+    }
+    MessageDialog::info(parent_, QStringLiteral("Обновление книги"),
+        message + QStringLiteral("\nТекущий список компьютеров сохранён."));
+}
