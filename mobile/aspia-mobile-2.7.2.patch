+    {
+        emit sig_messageReceived(router_id, channel_id, buffer);
+        return;
+    }
+    if (channel_id != 0 || it->legacy_requests.empty())
+    {
+        onChannelErrorOccurred(router_id, TcpChannel::ErrorCode::INVALID_PROTOCOL);
+        return;
+    }
+    const auto reply = LegacyRouterAdapter::reply(it->legacy_requests.front(), buffer);
+    if (!reply)
+    {
+        onChannelErrorOccurred(router_id, TcpChannel::ErrorCode::INVALID_PROTOCOL);
+        return;
+    }
+    it->legacy_requests.pop_front();
+    emit sig_messageReceived(router_id, proto::router::CHANNEL_ID_CLIENT, serialize(*reply));
+    sendNextLegacyRequest(*it);
