+TEST(AabImporterTest, ResolvesNearestGroupOverrideAndMissingGroupConfig)
+{
+    proto::address_book::Data data;
+    auto* root = data.mutable_root_group();
+    root->set_name("Book");
+    root->mutable_config()->set_username("root-login");
+    root->mutable_config()->set_password("root-password");
+    auto* parent = root->add_computer_group();
+    parent->set_name("No config inherits parent");
+    addHost(parent, true, "Parent host");
+    auto* child = parent->add_computer_group();
+    child->set_name("Own group credentials");
+    child->mutable_config()->set_username("child-login");
+    child->mutable_config()->set_password("child-password");
+    addHost(child, true, "Child inherited");
+    addHost(child, false, "Host override");
+    auto* deeper = child->add_computer_group();
+    deeper->set_name("Explicitly inherits");
+    deeper->mutable_config()->mutable_inherit()->set_credentials(true);
+    deeper->mutable_config()->set_username("ignored");
+    deeper->mutable_config()->set_password("ignored");
+    addHost(deeper, true, "Grandchild");
+    AabImporter::Book book;
+    ASSERT_EQ(AabImporter::read(wrap(serialize(data)), SecureString(), &book), Result::SUCCESS);
+    ASSERT_EQ(book.hosts.size(), 4);
+    EXPECT_EQ(book.hosts[0].password().toString(), "root-password");
+    EXPECT_EQ(book.hosts[1].password().toString(), "child-password");
+    EXPECT_EQ(book.hosts[2].password().toString(), "own-password");
+    EXPECT_EQ(book.hosts[3].password().toString(), "child-password");
+    EXPECT_EQ(book.groups.size(), 3);
+    EXPECT_EQ(book.groups[1].parentId(), book.groups[0].id());
+}
