+TEST(AabImporterTest, RejectsEmptyInvalidUnsupportedOversizeAndDeepFiles)
+{
+    AabImporter::Book book;
+    EXPECT_EQ(AabImporter::read(QByteArray(), SecureString(), &book), Result::INVALID_FORMAT);
+    EXPECT_EQ(AabImporter::read(QByteArray("not-a-book"), SecureString(), &book), Result::INVALID_FORMAT);
+    EXPECT_EQ(AabImporter::read(QByteArray(AabImporter::kMaxFileSize + 1, 'x'), SecureString(), &book),
+              Result::TOO_LARGE);
+    proto::address_book::Data empty;
+    empty.mutable_root_group()->set_name("Empty");
+    EXPECT_EQ(AabImporter::read(wrap(serialize(empty)), SecureString(), &book), Result::EMPTY_BOOK);
+    proto::address_book::File unsupported;
+    unsupported.set_encryption_type(proto::address_book::ENCRYPTION_TYPE_XCHACHA20_POLY1305);
+    unsupported.set_data("something");
+    EXPECT_EQ(AabImporter::read(serialize(unsupported), SecureString(), &book), Result::UNSUPPORTED_ENCRYPTION);
+    QByteArray group;
+    for (int i = 0; i < AabImporter::kMaxDepth + 2; ++i)
+        group = field(34, group);
+    EXPECT_EQ(AabImporter::read(wrap(field(18, group)), SecureString(), &book), Result::TOO_LARGE);
+    QByteArray many_hosts;
+    for (int i = 0; i <= AabImporter::kMaxHosts; ++i)
+        many_hosts.append("\x1a\x00", 2);
+    EXPECT_EQ(AabImporter::read(wrap(field(18, many_hosts)), SecureString(), &book), Result::TOO_LARGE);
+}
