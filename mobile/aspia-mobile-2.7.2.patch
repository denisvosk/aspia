new file mode 100644
index 0000000000000000000000000000000000000000..57faec9b37b42d48f58e01e6e2453b95778917e1
--- /dev/null
+++ b/.github/workflows/mobile-android.yml
@@ -0,0 +1,163 @@
+name: Aspia+ Android
+
+on:
+  push:
+    branches: [feature/android-2.7.2]
+    paths-ignore: ['README.md', 'docs/**']
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: aspia-mobile-${{ github.ref }}
+  cancel-in-progress: true
+
+env:
+  QT_VERSION: '6.11.1'
+  VCPKG_MAX_CONCURRENCY: '4'
+  VCPKG_DISABLE_METRICS: '1'
+  GRADLE_OPTS: '-Dorg.gradle.daemon=false'
+
+jobs:
+  native:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 120
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: true
+          fetch-depth: 1
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Build tools
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y ninja-build pkg-config autoconf automake libtool nasm libgl1-mesa-dev libxkbcommon0 bubblewrap
+          python -m pip install 'aqtinstall==3.3.0' 'cmake>=3.30,<4.0'
+      - name: Cache host Qt
+        id: native-qt-cache
+        uses: actions/cache@v4
+        with:
+          path: ${{ runner.temp }}/Qt
+          key: mobile-host-qt-${{ runner.os }}-${{ env.QT_VERSION }}-v1
+      - name: Install host Qt
+        if: steps.native-qt-cache.outputs.cache-hit != 'true'
+        run: aqt install-qt linux desktop "$QT_VERSION" linux_gcc_64 -O "$RUNNER_TEMP/Qt" --archives qtbase qttools qtsvg qttranslations qtdeclarative icu
+      - name: Cache native dependencies
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/vcpkg/archives
+          key: mobile-native-vcpkg-${{ runner.os }}-${{ hashFiles('ci/mobile-tests/vcpkg.json', '.gitmodules') }}-v1
+          restore-keys: mobile-native-vcpkg-${{ runner.os }}-
+      - name: Configure isolated tests
+        run: |
+          cmake -S ci/mobile-tests -B builds/mobile-tests -G Ninja \
+            -DCMAKE_BUILD_TYPE=Release \
+            -DCMAKE_TOOLCHAIN_FILE="$PWD/vcpkg4aspia/scripts/buildsystems/vcpkg.cmake" \
+            -DVCPKG_TARGET_TRIPLET=x64-linux -DVCPKG_HOST_TRIPLET=x64-linux \
+            -DCMAKE_PREFIX_PATH="$RUNNER_TEMP/Qt/$QT_VERSION/gcc_64"
+      - name: Compile production code and tests
+        run: cmake --build builds/mobile-tests --parallel 4
+      - name: Core and touch gesture tests
+        run: |
+          GTEST_OUTPUT="xml:$PWD/builds/mobile-tests/core-tests.xml" \
+            ctest --test-dir builds/mobile-tests --output-on-failure \
+            --output-junit "$PWD/builds/mobile-tests/native-tests.xml"
+      - name: Authenticated HTTPS and refusal checks
+        run: |
+          python source/client/tests/mobile_book_download_https_test.py \
+            --probe "$PWD/builds/mobile-tests/aspia_mobile_book_download_probe" \
+            --output "$PWD/builds/mobile-tests/https-results.json"
+      - name: Interoperate with the official 2.7 Router
+        run: |
+          curl --fail --location --retry 3 \
+            https://github.com/dchapyshev/aspia/releases/download/v2.7.0/aspia-router-2.7.0-x86_64.deb \
+            --output "$RUNNER_TEMP/router27.deb"
+          echo "ce00798bf068158b5b54c157d9b8944245edbc6d4a1b98eecad6039be62bbb9b  $RUNNER_TEMP/router27.deb" | sha256sum --check -
+          dpkg-deb --extract "$RUNNER_TEMP/router27.deb" "$RUNNER_TEMP/router27"
+          python source/client/tests/legacy_router_interop_test.py \
+            --router "$RUNNER_TEMP/router27/usr/bin/aspia_router" \
+            --probe "$PWD/builds/mobile-tests/aspia_legacy_router_probe" \
+            --output "$PWD/builds/mobile-tests/router27-results.json"
+      - uses: actions/upload-artifact@v4
+        if: always()
+        with:
+          name: aspia-mobile-native-checks
+          path: |
+            builds/mobile-tests/Testing/Temporary/LastTest.log
+            builds/mobile-tests/*-results.json
+            builds/mobile-tests/*-tests.xml
+          retention-days: 30
+  android:
+    needs: native
+    runs-on: ubuntu-24.04
+    timeout-minutes: 180
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          submodules: true
+          fetch-depth: 1
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: '21'
+      - uses: actions/setup-python@v5
+        with:
+          python-version: '3.12'
+      - name: Native build tools
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y ninja-build pkg-config autoconf automake libtool nasm libgl1-mesa-dev libxkbcommon0 patchelf
+          python -m pip install 'aqtinstall==3.3.0' 'cmake>=3.30,<4.0'
+      - name: Cache Qt
+        id: qt-cache
+        uses: actions/cache@v4
+        with:
+          path: ${{ runner.temp }}/Qt
+          key: mobile-qt-${{ runner.os }}-${{ env.QT_VERSION }}-android-arm64-v1
+      - name: Install Qt
+        if: steps.qt-cache.outputs.cache-hit != 'true'
+        run: |
+          aqt install-qt linux desktop "$QT_VERSION" linux_gcc_64 -O "$RUNNER_TEMP/Qt" --archives qtbase qttools qtsvg qttranslations qtdeclarative icu
+          aqt install-qt all_os android "$QT_VERSION" android_arm64_v8a -O "$RUNNER_TEMP/Qt" --archives qtbase qttools qtsvg qttranslations
+      - name: Android SDK
+        run: |
+          python - <<'PYSDK'
+          import subprocess
+          subprocess.run(['sdkmanager', 'platform-tools', 'platforms;android-36', 'build-tools;36.0.0', 'ndk;27.2.12479018'], input='y\n' * 100, text=True, stdout=subprocess.DEVNULL, check=True)
+          PYSDK
+          echo "ANDROID_SDK_ROOT=$ANDROID_HOME" >> "$GITHUB_ENV"
+          echo "ANDROID_NDK_ROOT=$ANDROID_HOME/ndk/27.2.12479018" >> "$GITHUB_ENV"
+          echo "ANDROID_NDK_HOME=$ANDROID_HOME/ndk/27.2.12479018" >> "$GITHUB_ENV"
+          echo "QT_ANDROID_PATH=$RUNNER_TEMP/Qt/$QT_VERSION/android_arm64_v8a" >> "$GITHUB_ENV"
+          echo "QT_HOST_PATH=$RUNNER_TEMP/Qt/$QT_VERSION/gcc_64" >> "$GITHUB_ENV"
+      - name: Cache compiled dependencies
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/vcpkg/archives
+          key: mobile-vcpkg-${{ runner.os }}-${{ hashFiles('.gitmodules', 'vcpkg.json') }}-ndk27-qt6111-v1
+          restore-keys: mobile-vcpkg-${{ runner.os }}-
+      - name: Build Android HTTPS runtime
+        run: |
+          ci/build-android-openssl.sh "$RUNNER_TEMP/android-openssl"
+          echo "ASPIA_ANDROID_TLS_DIR=$RUNNER_TEMP/android-openssl" >> "$GITHUB_ENV"
+      - name: Configure Client only
+        run: cmake --preset mobile-android-linux
+      - name: Build APK
+        run: cmake --build --preset mobile-android-linux-apk --parallel 4
+      - name: Collect unsigned release artifact
+        run: |
+          mkdir -p mobile-artifacts
+          APK=$(find builds/mobile-android-linux/source/client/android-build/build/outputs/apk/release -name '*unsigned.apk' -print -quit)
+          test -n "$APK"
+          cp "$APK" mobile-artifacts/aspia-plus-mobile-2.7.2-mobile.1-arm64-unsigned.apk
+          git rev-parse HEAD > mobile-artifacts/source-commit.txt
+          (cd mobile-artifacts && sha256sum *.apk > SHA256SUMS.txt)
+      - uses: actions/upload-artifact@v4
+        with:
+          name: aspia-plus-mobile-android-arm64
+          path: mobile-artifacts
+          retention-days: 30
+          if-no-files-found: error
