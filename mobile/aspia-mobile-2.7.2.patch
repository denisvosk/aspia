+//--------------------------------------------------------------------------------------------------
+std::optional<QByteArray> Database::mobileBookSource() const
+{
+    // Unlike readSetting(), this path must distinguish an absent value from a failed SQL read.
+    if (!isValid())
+        return std::nullopt;
+    SqlQuery query(db_, "SELECT value FROM settings WHERE name=?");
+    query.addText(std::string_view(kSettingMobileBookSource));
+    const SqlQuery::StepResult step = query.next();
+    if (step == SqlQuery::StepResult::FAILED)
+        return std::nullopt;
+    if (step == SqlQuery::StepResult::DONE)
+        return QByteArray();
+
+    const QByteArray encoded = query.columnText(0).toLatin1();
+    if (encoded.isEmpty())
+        return QByteArray();
+    if (encoded.size() > 2 * kMaxMobileBookSourceSize)
+        return std::nullopt;
+    const auto decoded = QByteArray::fromBase64Encoding(encoded, QByteArray::AbortOnBase64DecodingErrors);
+    if (!decoded || decoded.decoded.size() <= 28 ||
+        decoded.decoded.size() > kMaxMobileBookSourceSize + 28)
+    {
+        return std::nullopt;
+    }
+    return DataCryptor::instance().decrypt(decoded.decoded, kMobileBookSourceAad);
+}
+
+//--------------------------------------------------------------------------------------------------
+bool Database::setMobileBookSource(const QByteArray& json)
+{
+    if (json.isEmpty() || json.trimmed() == "{}")
+        return writeSetting(kSettingMobileBookSource, QString());
+    if (json.size() > kMaxMobileBookSourceSize)
+        return false;
+    const auto encrypted = DataCryptor::instance().encrypt(json, kMobileBookSourceAad);
+    return encrypted.has_value() &&
+        writeSetting(kSettingMobileBookSource, QString::fromLatin1(encrypted->toBase64()));
+}
