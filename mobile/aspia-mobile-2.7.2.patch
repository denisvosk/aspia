diff --git a/ci/sign-android-apk.sh b/ci/sign-android-apk.sh
new file mode 100755
index 0000000000000000000000000000000000000000..6d193d18bec26a471b325c9abaf345c84a82ea47
--- /dev/null
+++ b/ci/sign-android-apk.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# Sign with the existing Aspia+ Mobile release key. Never generate a new key for an update.
+# Usage: ANDROID_SDK_ROOT=... ci/sign-android-apk.sh input.apk output.apk key.p12 password-file
+set -euo pipefail
+umask 077
+
+if [[ $# != 4 ]]; then
+    echo "Usage: $0 unsigned.apk signed.apk key.p12 password-file" >&2
+    exit 2
+fi
+input_apk=$1
+output_apk=$2
+key_file=$3
+password_file=$4
+: "${ANDROID_SDK_ROOT:?Set ANDROID_SDK_ROOT to the installed Android SDK}"
+build_tools="$ANDROID_SDK_ROOT/build-tools/36.0.0"
+for required_file in "$input_apk" "$key_file" "$password_file"; do
+    test -f "$required_file" || { echo "Required input file is missing" >&2; exit 2; }
+done
+test ! -e "$output_apk" || { echo "Output already exists; choose a new path" >&2; exit 2; }
+
+aligned_apk=$(mktemp "${TMPDIR:-/tmp}/aspia-mobile-aligned.XXXXXXXX.apk")
+trap 'rm -f "$aligned_apk"' EXIT
+"$build_tools/zipalign" -P 16 -f 4 "$input_apk" "$aligned_apk"
+"$build_tools/apksigner" sign \
+    --ks "$key_file" --ks-key-alias aspia-plus-mobile \
+    --ks-pass "file:$password_file" --key-pass "file:$password_file" \
+    --out "$output_apk" "$aligned_apk"
+"$build_tools/apksigner" verify --verbose --print-certs "$output_apk"
+"$build_tools/zipalign" -c -P 16 4 "$output_apk"
+sha256sum "$output_apk"
diff --git a/ops/mobile/Install-Mobile-Book.ps1 b/ops/mobile/Install-Mobile-Book.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..559d20b7e9b844e4899261af824516185fb1b33a
--- /dev/null
+++ b/ops/mobile/Install-Mobile-Book.ps1
@@ -0,0 +1,208 @@
+﻿#Requires -Version 5.1
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory=$true)][string]$SourceBookPath,
+    [string]$CaddyPath = 'C:\chat_ZPP_bot\caddy.exe',
+    [string]$CaddyfilePath = 'C:\chat_ZPP_bot\Caddyfile',
+    [string]$PrivateDirectory = 'C:\Web\Aspia\private-mobile',
+    [string]$BackupDirectory = 'C:\Web\Aspia\backups\mobile-book',
+    [ValidatePattern('^[A-Za-z0-9_.-]{1,64}$')][string]$UserName = 'mobile',
+    [string]$CaddyAccount = '',
+    [switch]$RequireExisting
+)
+
+. (Join-Path $PSScriptRoot 'Mobile-Book.Common.ps1')
+
+if ($env:OS -ne 'Windows_NT') { throw 'This installer runs on the Windows Caddy server.' }
+$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
+$principal = New-Object Security.Principal.WindowsPrincipal($identity)
+if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
+    throw 'Open PowerShell as administrator, then run the installer again.'
+}
+
+function Get-CaddyReaderSid {
+    if ($CaddyAccount) {
+        $account = New-Object Security.Principal.NTAccount($CaddyAccount)
+        return $account.Translate([Security.Principal.SecurityIdentifier])
+    }
+    $owners = @{}
+    foreach ($processInfo in @(Get-CimInstance Win32_Process -Filter "Name='caddy.exe'")) {
+        if (-not $processInfo.ExecutablePath -or
+            -not $processInfo.ExecutablePath.Equals($CaddyPath, [StringComparison]::OrdinalIgnoreCase)) { continue }
+        $owner = Invoke-CimMethod -InputObject $processInfo -MethodName GetOwner
+        if ($owner.ReturnValue -ne 0 -or -not $owner.User) { continue }
+        $account = New-Object Security.Principal.NTAccount(($owner.Domain + '\' + $owner.User))
+        $sid = $account.Translate([Security.Principal.SecurityIdentifier])
+        $owners[$sid.Value] = $sid
+    }
+    if ($owners.Count -ne 1) {
+        throw 'Unable to identify the running Caddy account. Supply -CaddyAccount "DOMAIN\User" (or "NT AUTHORITY\SYSTEM" for a LocalSystem service). No files were published.'
+    }
+    return @($owners.Values)[0]
+}
+
+function Invoke-CaddyChecked {
+    param([string[]]$CaddyArguments)
+    $result = Invoke-BookProcess $CaddyPath $CaddyArguments -WorkingDirectory ([IO.Path]::GetDirectoryName($CaddyfilePath))
+    if ($result.ExitCode -ne 0) { throw ('Caddy failed: ' + $result.Error + $result.Output) }
+    return $result
+}
+
+function Get-EndpointStatus {
+    param([string]$Password = '', [string]$RequestPath = '/mobile-book/book.aab')
+    # curl reads this configuration (including the optional Authorization header) through stdin.
+    # Passwords are never process command-line arguments. --resolve tests this local Caddy while
+    # retaining the correct HTTPS identity and ordinary certificate verification.
+    $config = @"
+url = "https://90.150.90.54$RequestPath"
+resolve = "90.150.90.54:443:127.0.0.1"
+noproxy = "*"
+proto = "=https"
+max-time = 15
+connect-timeout = 5
+silent
+show-error
+output = "NUL"
+write-out = "%{http_code}"
+"@
+    if ($Password) {
+        $basic = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes($UserName + ':' + $Password))
+        $config += "`nheader = `"Authorization: Basic $basic`"`n"
+    }
+    $result = Invoke-BookProcess $curlPath @('--config', '-') -InputText $config -TimeoutSeconds 20
+    if ($result.ExitCode -ne 0 -or $result.Output.Trim() -notmatch '^[0-9]{3}$') {
+        throw 'The local HTTPS verification failed. Check that Caddy listens on 127.0.0.1:443 and that its certificate is trusted; TLS verification was not disabled.'
+    }
+    return [int]$result.Output.Trim()
+}
+
+$SourceBookPath = [IO.Path]::GetFullPath($SourceBookPath)
+$CaddyPath = [IO.Path]::GetFullPath($CaddyPath)
+$CaddyfilePath = [IO.Path]::GetFullPath($CaddyfilePath)
+$PrivateDirectory = ConvertTo-BookServerPath $PrivateDirectory
+$BackupDirectory = ConvertTo-BookServerPath $BackupDirectory
+if (-not [IO.File]::Exists($CaddyPath) -or -not [IO.File]::Exists($CaddyfilePath)) {
+    throw 'The selected Caddy executable or active configuration file does not exist.'
+}
+$curlPath = (Get-Command curl.exe -ErrorAction Stop).Source
+Assert-NoBookReparsePoint $PrivateDirectory
+Assert-NoBookReparsePoint $BackupDirectory
+Assert-NoBookReparsePoint $CaddyfilePath
+$bookPath = Join-Path $PrivateDirectory 'book.aab'
+Assert-NoBookReparsePoint $bookPath
+$bookBytes = Read-EncryptedAab $SourceBookPath
+$originalBytes = [IO.File]::ReadAllBytes($CaddyfilePath)
+$utf8 = New-Object Text.UTF8Encoding($false, $true)
+$original = [IO.File]::ReadAllText($CaddyfilePath, $utf8)
+[void](Get-MobileBookSite $original)
+$existing = Get-ManagedMobileBookBlock $original
+if ($RequireExisting -and $null -eq $existing) {
+    throw 'The private endpoint is not installed. Run Install-Mobile-Book.ps1 once first.'
+}
+$withoutManaged = $original
+if ($null -ne $existing) { $withoutManaged = $original.Remove($existing.Start, $existing.Length) }
+Assert-MobileBookOutsideWebRoots $withoutManaged $PrivateDirectory $BackupDirectory
+$readerSid = Get-CaddyReaderSid
+$newPassword = ''
+if ($null -ne $existing) {
+    $UserName = $existing.UserName
+    $passwordHash = $existing.PasswordHash
+} else {
+    $random = New-Object byte[] 24
+    $generator = [Security.Cryptography.RandomNumberGenerator]::Create()
+    try { $generator.GetBytes($random) } finally { $generator.Dispose() }
+    $newPassword = [Convert]::ToBase64String($random).Replace('+','-').Replace('/','_').TrimEnd('=')
+    [Array]::Clear($random, 0, $random.Length)
+    $hashResult = Invoke-BookProcess $CaddyPath @('hash-password', '--algorithm', 'bcrypt') -InputText ($newPassword + [Environment]::NewLine)
+    if ($hashResult.ExitCode -ne 0) { throw 'Caddy could not hash the new access password.' }
+    $passwordHash = $hashResult.Output.Trim()
+}
+$block = New-MobileBookCaddyBlock $UserName $passwordHash $PrivateDirectory
+$candidate = Set-MobileBookCaddyBlock $original $block
+$candidatePath = Join-Path ([IO.Path]::GetDirectoryName($CaddyfilePath)) ('Caddyfile.mobile-' + [Guid]::NewGuid().ToString('N') + '.tmp')
+$mutex = New-Object Threading.Mutex($false, 'Global\AspiaPlusMobileBookPublisher')
+$locked = $false; $configCommitted = $false; $bookCommitted = $false
+$oldBook = $false
+$previousPrivateAcl = $null
+$privateAclChanged = $false
+$runBackup = $null
+try {
+    $locked = $mutex.WaitOne(0)
+    if (-not $locked) { throw 'Another mobile-book publication is already running.' }
+    $oldBook = [IO.File]::Exists($bookPath)
+    if ([IO.Directory]::Exists($PrivateDirectory)) { $previousPrivateAcl = Get-Acl -LiteralPath $PrivateDirectory }
+    [IO.File]::WriteAllBytes($candidatePath, $utf8.GetBytes($candidate))
+    [void](Invoke-CaddyChecked @('validate', '--config', $candidatePath, '--adapter', 'caddyfile'))
+    if ([Convert]::ToBase64String([IO.File]::ReadAllBytes($CaddyfilePath)) -ne [Convert]::ToBase64String($originalBytes)) {
+        throw 'The Caddyfile changed during preparation; run the command again.'
+    }
+
+    Set-PrivateBookDirectory $BackupDirectory
+    $runBackup = Join-Path $BackupDirectory ((Get-Date -Format 'yyyyMMdd-HHmmss') + '-' + [Guid]::NewGuid().ToString('N').Substring(0,8))
+    Set-PrivateBookDirectory $runBackup
+    [IO.File]::WriteAllBytes((Join-Path $runBackup 'Caddyfile.before'), $originalBytes)
+    if ($oldBook) { [IO.File]::Copy($bookPath, (Join-Path $runBackup 'book.before.aab'), $false) }
+    Set-PrivateBookDirectory $PrivateDirectory $readerSid
+    $privateAclChanged = $true
+    Write-BookFileAtomically $bookPath $bookBytes
+    $bookCommitted = $true
+    Set-PrivateBookFile $bookPath $readerSid
+    if ($candidate -cne $original) {
+        Write-BookFileAtomically $CaddyfilePath $utf8.GetBytes($candidate)
+        $configCommitted = $true
+        [void](Invoke-CaddyChecked @('reload', '--config', $CaddyfilePath, '--adapter', 'caddyfile'))
+    }
+    if ((Get-EndpointStatus) -ne 401) { throw 'The endpoint did not require authentication; publication has been rolled back.' }
+    if ($newPassword -and (Get-EndpointStatus $newPassword) -ne 200) {
+        throw 'The protected book could not be downloaded with its new credentials; publication has been rolled back.'
+    }
+    if ((Get-EndpointStatus -RequestPath '/mobile-book/not-a-book.txt') -ne 404) {
+        throw 'Unexpected access to a path beside the book; publication has been rolled back.'
+    }
+    $sha = [Security.Cryptography.SHA256]::Create()
+    try { $digest = ([BitConverter]::ToString($sha.ComputeHash($bookBytes))).Replace('-','').ToLowerInvariant() }
+    finally { $sha.Dispose() }
+    Write-Host ''
+    Write-Host 'Готово. Зашифрованная адресная книга опубликована с авторизацией.'
+    Write-Host 'Адрес в приложении: https://90.150.90.54/mobile-book/book.aab'
+    Write-Host "Логин для скачивания: $UserName"
+    if ($newPassword) {
+        Write-Host "Пароль для скачивания: $newPassword"
+        Write-Host 'Сохраните пароль: на сервер записан только bcrypt-хеш. Это отдельный пароль, не пароль шифрования книги.'
+    } else { Write-Host 'Пароль для скачивания сохранён прежний.' }
+    Write-Host "Книга: $bookPath"
+    Write-Host "SHA-256: $digest"
+    Write-Host "Резервная копия: $runBackup"
+    Write-Host 'Без логина и пароля сервер вернул 401. Другие файлы этой папки через маршрут не выдаются.'
+} catch {
+    $failure = $_
+    $rollbackFailures = New-Object 'System.Collections.Generic.List[string]'
+    if ($configCommitted) {
+        try { Write-BookFileAtomically $CaddyfilePath $originalBytes }
+        catch { $rollbackFailures.Add('Could not restore the previous Caddyfile.') }
+    }
+    if ($bookCommitted) {
+        try {
+            if ($oldBook) {
+                $saved = [IO.File]::ReadAllBytes((Join-Path $runBackup 'book.before.aab'))
+                Write-BookFileAtomically $bookPath $saved
+            } elseif ([IO.File]::Exists($bookPath)) { [IO.File]::Delete($bookPath) }
+        } catch { $rollbackFailures.Add('Could not restore the previous book.') }
+    }
+    if ($privateAclChanged -and $null -ne $previousPrivateAcl) {
+        try { Set-Acl -LiteralPath $PrivateDirectory -AclObject $previousPrivateAcl }
+        catch { $rollbackFailures.Add('Could not restore the previous private-folder permissions.') }
+    }
+    if ($configCommitted) {
+        try { [void](Invoke-CaddyChecked @('reload', '--config', $CaddyfilePath, '--adapter', 'caddyfile')) }
+        catch { $rollbackFailures.Add('Could not reload the previous Caddy configuration.') }
+    }
+    if ($rollbackFailures.Count -gt 0) {
+        throw ($failure.ToString() + "`nRollback needs attention: " + ($rollbackFailures -join ' ') + "`nBackup: $runBackup")
+    }
+    throw $failure
+} finally {
+    if ([IO.File]::Exists($candidatePath)) { [IO.File]::Delete($candidatePath) }
+    if ($locked) { $mutex.ReleaseMutex() }
+    $mutex.Dispose()
+}
diff --git a/ops/mobile/Mobile-Book.Common.ps1 b/ops/mobile/Mobile-Book.Common.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..fdf2f392be8dea6620ab34a3bf507add0fa27c63
--- /dev/null
+++ b/ops/mobile/Mobile-Book.Common.ps1
@@ -0,0 +1,359 @@
+﻿# Aspia+ Mobile book provisioning helpers. GPL-3.0-or-later.
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+$script:MobileBookMaximumBytes = 16 * 1024 * 1024
+$script:MobileBookBegin = '# BEGIN ASPIA_PLUS_MOBILE_BOOK'
+$script:MobileBookEnd = '# END ASPIA_PLUS_MOBILE_BOOK'
+
+function Read-ProtoUInt32 {
+    param([byte[]]$Bytes, [ref]$Offset)
+    [uint64]$value = 0
+    for ($i = 0; $i -lt 5; $i++) {
+        if ($Offset.Value -ge $Bytes.Length) { throw 'Truncated protobuf varint.' }
+        [byte]$part = $Bytes[$Offset.Value]; $Offset.Value++
+        if ($i -eq 4 -and $part -gt 15) { throw 'Protobuf integer overflow.' }
+        $value = $value -bor ([uint64]($part -band 127) -shl (7 * $i))
+        if (($part -band 128) -eq 0) { return [uint32]$value }
+    }
+    throw 'Invalid protobuf integer.'
+}
+
+function Test-EncryptedAabBytes {
+    param([Parameter(Mandatory=$true)][byte[]]$Bytes)
+    if ($Bytes.Length -eq 0 -or $Bytes.Length -gt $script:MobileBookMaximumBytes) {
+        throw 'The .aab file must be nonempty and at most 16 MiB.'
+    }
+    $offset = 0; $encryption = -1; $saltLength = 0; $dataLength = 0
+    $seen = @{}
+    while ($offset -lt $Bytes.Length) {
+        $tag = Read-ProtoUInt32 $Bytes ([ref]$offset)
+        $field = $tag -shr 3; $wire = $tag -band 7
+        if ($field -eq 0) { throw 'Invalid protobuf field number.' }
+        if ($field -in @(1, 3, 9)) {
+            if ($seen.ContainsKey($field)) { throw 'Duplicate address-book header field.' }
+            $seen[$field] = $true
+        }
+        if ($field -eq 1) {
+            if ($wire -ne 0) { throw 'Invalid encryption header.' }
+            $encryption = Read-ProtoUInt32 $Bytes ([ref]$offset)
+            continue
+        }
+        if ($field -in @(3, 9) -and $wire -ne 2) { throw 'Invalid address-book payload header.' }
+        switch ($wire) {
+            0 {
+                $done = $false
+                for ($i = 0; $i -lt 10; $i++) {
+                    if ($offset -ge $Bytes.Length) { throw 'Truncated protobuf field.' }
+                    $part = $Bytes[$offset]; $offset++
+                    if ($i -eq 9 -and $part -gt 1) { throw 'Protobuf integer overflow.' }
+                    if (($part -band 128) -eq 0) { $done = $true; break }
+                }
+                if (-not $done) { throw 'Invalid protobuf field.' }
+            }
+            1 { $offset += 8 }
+            2 {
+                $length = Read-ProtoUInt32 $Bytes ([ref]$offset)
+                if ($length -gt ($Bytes.Length - $offset)) { throw 'Truncated address-book data.' }
+                if ($field -eq 3) { $saltLength = $length }
+                if ($field -eq 9) { $dataLength = $length }
+                $offset += $length
+            }
+            5 { $offset += 4 }
+            default { throw 'Unsupported protobuf wire format.' }
+        }
+        if ($offset -gt $Bytes.Length) { throw 'Truncated protobuf field.' }
+    }
+    if ($encryption -ne 3) {
+        throw 'Publish refused: this is not an encrypted Aspia 2.7 ChaCha20-Poly1305 address book. Enable encryption in Console and save the .aab again.'
+    }
+    if ($saltLength -lt 1 -or $saltLength -gt 1024 -or $dataLength -le 28) {
+        throw 'Invalid encrypted .aab envelope.'
+    }
+    return $true
+}
+
+function Read-EncryptedAab {
+    param([Parameter(Mandatory=$true)][string]$Path)
+    $stream = [IO.File]::Open($Path, [IO.FileMode]::Open, [IO.FileAccess]::Read, [IO.FileShare]::Read)
+    try {
+        if ($stream.Length -gt $script:MobileBookMaximumBytes) { throw 'The .aab file exceeds 16 MiB.' }
+        $memory = New-Object IO.MemoryStream
+        try {
+            $buffer = New-Object byte[] 65536
+            while (($count = $stream.Read($buffer, 0, $buffer.Length)) -gt 0) {
+                if ($memory.Length + $count -gt $script:MobileBookMaximumBytes) { throw 'The .aab file exceeds 16 MiB.' }
+                $memory.Write($buffer, 0, $count)
+            }
+            $bytes = $memory.ToArray()
+        } finally { $memory.Dispose() }
+    } finally { $stream.Dispose() }
+    [void](Test-EncryptedAabBytes $bytes)
+    return ,$bytes
+}
+
+function Get-CaddyMaskedText {
+    param([string]$Text)
+    $result = $Text.ToCharArray(); $quote = [char]0; $comment = $false
+    for ($i = 0; $i -lt $Text.Length; $i++) {
+        $c = $Text[$i]
+        if ($comment) {
+            if ($c -eq "`n" -or $c -eq "`r") { $comment = $false } else { $result[$i] = ' ' }
+            continue
+        }
+        if ($quote -ne [char]0) {
+            if ($c -eq '\' -and $quote -eq '"') {
+                $result[$i] = ' '
+                if ($i + 1 -lt $Text.Length) { $i++; $result[$i] = ' ' }
+                continue
+            }
+            if ($c -eq $quote) { $quote = [char]0 }
+            if ($c -ne "`n" -and $c -ne "`r") { $result[$i] = ' ' }
+            continue
+        }
+        if ($c -eq '#') { $comment = $true; $result[$i] = ' '; continue }
+        if ($c -eq '"' -or $c -eq '`') { $quote = $c; $result[$i] = ' '; continue }
+        if ($c -eq '<' -and $i + 1 -lt $Text.Length -and $Text[$i+1] -eq '<') {
+            throw 'Caddy heredoc syntax needs a manual review; the active configuration was not changed.'
+        }
+    }
+    if ($quote -ne [char]0) { throw 'Unclosed Caddy string.' }
+    return (-join $result)
+}
+
+function Get-MobileBookSite {
+    param([string]$Text)
+    $masked = Get-CaddyMaskedText $Text
+    if ($masked -match '(?m)^\s*import\s') {
+        throw 'Caddy import directives need a manual review; no configuration changes were made.'
+    }
+    $matches = [regex]::Matches($masked, '(?m)^[ \t]*https://90[.]150[.]90[.]54[ \t]*\{[ \t]*\r?$')
+    if ($matches.Count -ne 1) { throw 'Expected one explicit https://90.150.90.54 { site block.' }
+    $open = $matches[0].Index + $matches[0].Value.IndexOf('{')
+    $depth = 0; $close = -1
+    for ($i = 0; $i -lt $masked.Length; $i++) {
+        if ($i -eq $open -and $depth -ne 0) { throw 'The target site is not a top-level Caddy block.' }
+        if ($masked[$i] -eq '{') { $depth++ }
+        if ($masked[$i] -eq '}') {
+            $depth--
+            if ($depth -lt 0) { throw 'Unbalanced Caddy configuration.' }
+            if ($i -gt $open -and $depth -eq 0 -and $close -lt 0) { $close = $i }
+        }
+    }
+    if ($depth -ne 0 -or $close -lt 0) { throw 'Unbalanced Caddy site block.' }
+    $body = $masked.Substring($open + 1, $close - $open - 1)
+    $level = 1
+    foreach ($line in ($body -split "`n")) {
+        $trimmed = $line.Trim()
+        if ($level -eq 1 -and $trimmed.Length -gt 0) {
+            $directive = ($trimmed -split '\s+')[0]
+            if ($directive -notin @('root', 'tls', 'handle', 'handle_path', 'header', 'encode', 'log') -and
+                -not $directive.StartsWith('@')) {
+                throw "Unsupported top-level site directive '$directive'; no configuration changes were made."
+            }
+        }
+        foreach ($c in $line.ToCharArray()) {
+            if ($c -eq '{') { $level++ }
+            if ($c -eq '}') { $level-- }
+        }
+    }
+    return [pscustomobject]@{ Open = $open; Close = $close; Masked = $masked }
+}
+
+function Get-ManagedMobileBookBlock {
+    param([string]$Text)
+    $begin = [regex]::Matches($Text, '(?m)^[ \t]*# BEGIN ASPIA_PLUS_MOBILE_BOOK[ \t]*\r?$')
+    $end = [regex]::Matches($Text, '(?m)^[ \t]*# END ASPIA_PLUS_MOBILE_BOOK[ \t]*\r?$')
+    if ($begin.Count -eq 0 -and $end.Count -eq 0) { return $null }
+    if ($begin.Count -ne 1 -or $end.Count -ne 1 -or $begin[0].Index -ge $end[0].Index) {
+        throw 'Incomplete or repeated Aspia+ Mobile configuration markers.'
+    }
+    $start = $begin[0].Index; $stop = $end[0].Index + $end[0].Length
+    $block = $Text.Substring($start, $stop - $start)
+    $credentials = [regex]::Matches($block, '(?m)^[ \t]*(?<user>[A-Za-z0-9_.-]{1,64})[ \t]+(?<hash>\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53})[ \t]*\r?$')
+    if ($credentials.Count -ne 1) { throw 'Unable to preserve the installed mobile-book login and password hash.' }
+    return [pscustomobject]@{ Start = $start; Length = $stop - $start; Text = $block;
+        UserName = $credentials[0].Groups['user'].Value; PasswordHash = $credentials[0].Groups['hash'].Value }
+}
+
+function ConvertTo-BookServerPath {
+    param([string]$Path)
+    if ($Path -notmatch '^[A-Za-z]:[\\/]' -or $Path -match '["\x00\r\n{}*?<>|]') {
+        throw 'An absolute Windows directory without Caddy placeholders is required.'
+    }
+    $parts = New-Object 'System.Collections.Generic.List[string]'
+    foreach ($part in ($Path.Substring(3) -split '[\\/]')) {
+        if ($part -eq '' -or $part -eq '.') { continue }
+        if ($part -eq '..') {
+            if ($parts.Count -eq 0) { throw 'Invalid directory traversal.' }
+            $parts.RemoveAt($parts.Count - 1)
+        } else {
+            if ($part -match '[:]' -or $part.EndsWith('.') -or $part.EndsWith(' ')) {
+                throw 'The directory contains an ambiguous Windows path component.'
+            }
+            $parts.Add($part)
+        }
+    }
+    return $Path.Substring(0,2).ToUpperInvariant() + '\' + ($parts -join '\')
+}
+
+function Assert-MobileBookOutsideWebRoots {
+    param([string]$Text, [string]$PrivateDirectory, [string]$BackupDirectory)
+    $targets = @((ConvertTo-BookServerPath $PrivateDirectory), (ConvertTo-BookServerPath $BackupDirectory))
+    foreach ($match in [regex]::Matches($Text, '(?m)^[ \t]*root[ \t]+(?:\*[ \t]+|@[A-Za-z0-9_]+[ \t]+)?(?<path>"[^"\r\n]+"|[^\s#]+)[ \t]*(?:#.*)?\r?$')) {
+        $root = ConvertTo-BookServerPath $match.Groups['path'].Value.Trim('"')
+        foreach ($target in $targets) {
+            if ($target.Equals($root, [StringComparison]::OrdinalIgnoreCase) -or
+                $target.StartsWith($root.TrimEnd('\') + '\', [StringComparison]::OrdinalIgnoreCase)) {
+                throw 'The private book or its backups would fall inside a public Caddy root. No files were published.'
+            }
+        }
+    }
+}
+
+function New-MobileBookCaddyBlock {
+    param([string]$UserName, [string]$PasswordHash, [string]$PrivateDirectory)
+    if ($UserName -notmatch '^[A-Za-z0-9_.-]{1,64}$' -or $PasswordHash -notmatch '^\$2[aby]\$[0-9]{2}\$[./A-Za-z0-9]{53}$') {
+        throw 'Invalid mobile-book login or bcrypt hash.'
+    }
+    $directory = (ConvertTo-BookServerPath $PrivateDirectory).Replace('\', '/')
+    return @"
+    # BEGIN ASPIA_PLUS_MOBILE_BOOK
+    handle /mobile-book/book.aab {
+        route {
+            basic_auth {
+                $UserName $PasswordHash
+            }
+            @mobile_book_wrong_method not method GET HEAD
+            respond @mobile_book_wrong_method "Method not allowed" 405
+            header {
+                Cache-Control "private, no-store"
+                X-Content-Type-Options "nosniff"
+                Content-Type "application/octet-stream"
+            }
+            root * "$directory"
+            rewrite * /book.aab
+            file_server
+        }
+    }
+    handle /mobile-book/* {
+        respond 404
+    }
+    handle /mobile-book {
+        respond 404
+    }
+    # END ASPIA_PLUS_MOBILE_BOOK
+"@
+}
+
+function Set-MobileBookCaddyBlock {
+    param([string]$Text, [string]$Block)
+    $site = Get-MobileBookSite $Text
+    $managed = Get-ManagedMobileBookBlock $Text
+    if ($null -ne $managed) {
+        if ($managed.Start -le $site.Open -or $managed.Start + $managed.Length -ge $site.Close) {
+            throw 'The mobile-book markers are outside the expected HTTPS site.'
+        }
+        $without = $Text.Remove($managed.Start, $managed.Length)
+    } else { $without = $Text }
+    $bareSite = Get-MobileBookSite $without
+    $body = $bareSite.Masked.Substring($bareSite.Open+1, $bareSite.Close-$bareSite.Open-1)
+    if ($body.Contains('/mobile-book')) { throw 'A separate mobile-book route already exists; no changes were made.' }
+    $newline = "`n"; if ($Text.Contains("`r`n")) { $newline = "`r`n" }
+    $block = ($Block -replace "`r?`n", $newline)
+    if ($null -ne $managed) {
+        return $Text.Remove($managed.Start, $managed.Length).Insert($managed.Start, $block)
+    }
+    return $Text.Insert($site.Open + 1, $newline + $block + $newline)
+}
+
+function ConvertTo-ProcessArgument {
+    param([string]$Value)
+    if ($Value -notmatch '[\s"]' -and $Value.Length -gt 0) { return $Value }
+    $quoted = [regex]::Replace($Value, '(\\*)"', '$1$1\"')
+    $quoted = [regex]::Replace($quoted, '(\\+)$', '$1$1')
+    return '"' + $quoted + '"'
+}
+
+function Invoke-BookProcess {
+    param([string]$Executable, [string[]]$Arguments, [string]$InputText = '', [int]$TimeoutSeconds = 60,
+          [string]$WorkingDirectory = '')
+    $start = New-Object Diagnostics.ProcessStartInfo
+    $start.FileName = $Executable
+    $start.Arguments = (($Arguments | ForEach-Object { ConvertTo-ProcessArgument $_ }) -join ' ')
+    $start.UseShellExecute = $false; $start.CreateNoWindow = $true
+    $start.RedirectStandardInput = $true; $start.RedirectStandardOutput = $true; $start.RedirectStandardError = $true
+    if ($WorkingDirectory) { $start.WorkingDirectory = $WorkingDirectory }
+    $process = New-Object Diagnostics.Process
+    $process.StartInfo = $start
+    try {
+        if (-not $process.Start()) { throw 'Unable to start required helper.' }
+        $outTask = $process.StandardOutput.ReadToEndAsync(); $errTask = $process.StandardError.ReadToEndAsync()
+        $process.StandardInput.Write($InputText); $process.StandardInput.Close()
+        if (-not $process.WaitForExit($TimeoutSeconds * 1000)) {
+            $process.Kill(); throw 'The helper exceeded its time limit.'
+        }
+        $stdout = $outTask.GetAwaiter().GetResult(); $stderr = $errTask.GetAwaiter().GetResult()
+        return [pscustomobject]@{ ExitCode=$process.ExitCode; Output=$stdout; Error=$stderr }
+    } finally { $process.Dispose() }
+}
+
+function Write-BookFileAtomically {
+    param([string]$Path, [byte[]]$Bytes)
+    $temporary = $Path + '.' + [Guid]::NewGuid().ToString('N') + '.tmp'
+    try {
+        [IO.File]::WriteAllBytes($temporary, $Bytes)
+        if ([IO.File]::Exists($Path)) { [IO.File]::Replace($temporary, $Path, $null) }
+        else { [IO.File]::Move($temporary, $Path) }
+    } finally { if ([IO.File]::Exists($temporary)) { [IO.File]::Delete($temporary) } }
+}
+
+function Assert-NoBookReparsePoint {
+    param([string]$Path)
+    $current = [IO.Path]::GetFullPath($Path)
+    while ($current) {
+        if (Test-Path -LiteralPath $current) {
+            $item = Get-Item -LiteralPath $current -Force
+            if (($item.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {
+                throw "A reparse point is not supported for private deployment: $current"
+            }
+        }
+        $parent = [IO.Directory]::GetParent($current)
+        if ($null -eq $parent) { break }
+        $current = $parent.FullName
+    }
+}
+
+function Set-PrivateBookDirectory {
+    param([string]$Path, [Security.Principal.SecurityIdentifier]$ReaderSid)
+    [void][IO.Directory]::CreateDirectory($Path)
+    $acl = New-Object Security.AccessControl.DirectorySecurity
+    $acl.SetAccessRuleProtection($true, $false)
+    $inherit = [Security.AccessControl.InheritanceFlags]'ContainerInherit, ObjectInherit'
+    $none = [Security.AccessControl.PropagationFlags]::None
+    $allow = [Security.AccessControl.AccessControlType]::Allow
+    $owners = @('S-1-5-18', 'S-1-5-32-544', [Security.Principal.WindowsIdentity]::GetCurrent().User.Value)
+    foreach ($sidText in ($owners | Select-Object -Unique)) {
+        $sid = New-Object Security.Principal.SecurityIdentifier($sidText)
+        $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', $inherit, $none, $allow)))
+    }
+    if ($null -ne $ReaderSid -and $ReaderSid.Value -notin $owners) {
+        $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($ReaderSid, 'ReadAndExecute', $inherit, $none, $allow)))
+    }
+    Set-Acl -LiteralPath $Path -AclObject $acl
+}
+
+function Set-PrivateBookFile {
+    param([string]$Path, [Security.Principal.SecurityIdentifier]$ReaderSid)
+    $acl = New-Object Security.AccessControl.FileSecurity
+    $acl.SetAccessRuleProtection($true, $false)
+    $allow = [Security.AccessControl.AccessControlType]::Allow
+    $owners = @('S-1-5-18', 'S-1-5-32-544', [Security.Principal.WindowsIdentity]::GetCurrent().User.Value)
+    foreach ($sidText in ($owners | Select-Object -Unique)) {
+        $sid = New-Object Security.Principal.SecurityIdentifier($sidText)
+        $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($sid, 'FullControl', $allow)))
+    }
+    if ($null -ne $ReaderSid -and $ReaderSid.Value -notin $owners) {
+        $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($ReaderSid, 'Read', $allow)))
+    }
+    Set-Acl -LiteralPath $Path -AclObject $acl
+}
