diff --git a/source/client/mobile_book_download.cc b/source/client/mobile_book_download.cc
new file mode 100644
index 0000000000000000000000000000000000000000..84eb258fa079c7d6eb9467f47711e8d44c138af6
--- /dev/null
+++ b/source/client/mobile_book_download.cc
@@ -0,0 +1,159 @@
+// Aspia+ mobile book delivery. Distributed under GPL-3.0-or-later.
+#include "client/mobile_book_download.h"
+
+#include <QNetworkReply>
+#include <QNetworkRequest>
+#include <QSslError>
+#include <QSslSocket>
+
+bool MobileBookDownload::isValidSource(const QUrl& url, const QString& username,
+                                      const SecureString& password)
+{
+    return url.isValid() && url.scheme() == "https" && !url.host().isEmpty() &&
+           !url.path().isEmpty() && url.path() != "/" && url.userInfo().isEmpty() &&
+           !url.hasFragment() && url.port(443) > 0 && url.port(443) <= 65535 &&
+           !username.isEmpty() && username.size() <= 256 && !username.contains(':') &&
+           !username.contains('\r') && !username.contains('\n') &&
+           !password.isEmpty() && password.size() <= 4096 && url.toString().size() <= 4096;
+}
+
+MobileBookDownload::MobileBookDownload(QObject* parent) : QObject(parent)
+{
+    deadline_.setSingleShot(true);
+    connect(&deadline_, &QTimer::timeout, this, [this]() { finish(Result::TIMED_OUT); });
+}
+
+MobileBookDownload::~MobileBookDownload()
+{
+    if (reply_)
+    {
+        reply_->disconnect(this);
+        reply_->abort();
+    }
+}
+
+void MobileBookDownload::start(const QUrl& url, const QString& username,
+                               const SecureString& password, const QByteArray& etag)
+{
+    if (started_)
+        return;
+    started_ = true;
+    if (!isValidSource(url, username, password))
+    {
+        QTimer::singleShot(0, this, [this]() { finish(Result::INVALID_SOURCE); });
+        return;
+    }
+    if (!QSslSocket::supportsSsl())
+    {
+        QTimer::singleShot(0, this, [this]() { finish(Result::TLS_UNAVAILABLE); });
+        return;
+    }
+
+    QNetworkRequest request(url);
+    request.setAttribute(QNetworkRequest::RedirectPolicyAttribute,
+                         QNetworkRequest::ManualRedirectPolicy);
+    request.setAttribute(QNetworkRequest::CookieLoadControlAttribute, QNetworkRequest::Manual);
+    request.setAttribute(QNetworkRequest::CookieSaveControlAttribute, QNetworkRequest::Manual);
+    request.setAttribute(QNetworkRequest::CacheLoadControlAttribute, QNetworkRequest::AlwaysNetwork);
+    request.setAttribute(QNetworkRequest::CacheSaveControlAttribute, false);
+    request.setTransferTimeout(30000);
+    request.setDecompressedSafetyCheckThreshold(kMaxSize);
+    request.setRawHeader("Accept", "application/octet-stream");
+    request.setRawHeader("Accept-Encoding", "identity");
+    request.setRawHeader("User-Agent", "AspiaPlus-Mobile/2.7.2");
+    QByteArray auth = username.toUtf8() + ':' + password.toString().toUtf8();
+    request.setRawHeader("Authorization", "Basic " + auth.toBase64());
+    auth.fill('\0');
+    if (!etag.isEmpty() && etag.size() <= 1024 && !etag.contains('\r') && !etag.contains('\n'))
+    {
+        request.setRawHeader("If-None-Match", etag);
+        conditional_ = true;
+    }
+
+    reply_ = manager_.get(request);
+    reply_->setReadBufferSize(64 * 1024);
+    connect(reply_, &QNetworkReply::readyRead, this, &MobileBookDownload::readAvailable);
+    connect(reply_, &QNetworkReply::metaDataChanged, this, [this]()
+    {
+        if (reply_ && reply_->header(QNetworkRequest::ContentLengthHeader).toLongLong() > kMaxSize)
+            finish(Result::TOO_LARGE);
+    });
+    connect(reply_, &QNetworkReply::sslErrors, this, [this](const QList<QSslError>&)
+    {
+        // A certificate error never falls back to HTTP or ignoreSslErrors().
+        finish(Result::TLS_FAILED);
+    });
+    connect(reply_, &QNetworkReply::finished, this, &MobileBookDownload::onFinished);
+    deadline_.start(120000);
+}
+
+void MobileBookDownload::cancel()
+{
+    finish(Result::CANCELED);
+}
+
+void MobileBookDownload::readAvailable()
+{
+    if (!reply_ || finished_)
+        return;
+    while (reply_->bytesAvailable() > 0)
+    {
+        QByteArray chunk = reply_->read(64 * 1024);
+        if (chunk.size() > kMaxSize - data_.size())
+        {
+            finish(Result::TOO_LARGE);
+            return;
+        }
+        data_.append(chunk);
+    }
+}
+
+void MobileBookDownload::onFinished()
+{
+    if (finished_ || !reply_)
+        return;
+    readAvailable();
+    if (finished_)
+        return;
+    const int code = reply_->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+    if (code == 401 || code == 403)
+        finish(Result::AUTH_FAILED);
+    else if (code == 304 && conditional_)
+        finish(Result::UNCHANGED);
+    else if (code >= 300 && code < 400)
+        finish(Result::REDIRECT);
+    else if (reply_->error() == QNetworkReply::TimeoutError)
+        finish(Result::TIMED_OUT);
+    else if (code != 0 && code != 200)
+        finish(Result::HTTP_ERROR);
+    else if (reply_->error() != QNetworkReply::NoError || code != 200)
+        finish(Result::NETWORK_ERROR);
+    else
+        finish(Result::SUCCESS);
+}
+
+void MobileBookDownload::finish(Result result)
+{
+    if (finished_)
+        return;
+    finished_ = true;
+    deadline_.stop();
+    int status = 0;
+    QByteArray etag;
+    if (reply_)
+    {
+        status = reply_->attribute(QNetworkRequest::HttpStatusCodeAttribute).toInt();
+        etag = reply_->rawHeader("ETag");
+        if (etag.size() > 1024 || etag.contains('\r') || etag.contains('\n'))
+            etag.clear();
+        reply_->disconnect(this);
+        if (!reply_->isFinished())
+            reply_->abort();
+        reply_->deleteLater();
+        reply_.clear();
+    }
+    if (result != Result::SUCCESS)
+        data_.clear();
+    emit sig_finished(result, data_, etag, status);
+    data_.clear();
+}
diff --git a/source/client/mobile_book_download.h b/source/client/mobile_book_download.h
new file mode 100644
index 0000000000000000000000000000000000000000..685330d0b1010daac74d6835101fa646856fcf24
--- /dev/null
+++ b/source/client/mobile_book_download.h
@@ -0,0 +1,55 @@
+// Aspia+ mobile book delivery. Distributed under GPL-3.0-or-later.
+#ifndef CLIENT_MOBILE_BOOK_DOWNLOAD_H
+#define CLIENT_MOBILE_BOOK_DOWNLOAD_H
+
+#include <QByteArray>
+#include <QNetworkAccessManager>
+#include <QObject>
+#include <QPointer>
+#include <QTimer>
+#include <QUrl>
+
+#include "base/crypto/secure_string.h"
+
+class QNetworkReply;
+
+// A single authenticated HTTPS download. No redirects, cookies, disk cache or TLS exceptions.
+// The caller validates and decrypts the complete book before replacing any local records.
+class MobileBookDownload final : public QObject
+{
+    Q_OBJECT
+public:
+    enum class Result { SUCCESS, UNCHANGED, CANCELED, INVALID_SOURCE, AUTH_FAILED,
+                        TLS_FAILED, TOO_LARGE, TIMED_OUT, REDIRECT, HTTP_ERROR, NETWORK_ERROR,
+                        TLS_UNAVAILABLE };
+    Q_ENUM(Result)
+
+    static constexpr qsizetype kMaxSize = 16 * 1024 * 1024;
+    static bool isValidSource(const QUrl& url, const QString& username,
+                              const SecureString& password);
+
+    explicit MobileBookDownload(QObject* parent = nullptr);
+    ~MobileBookDownload() final;
+    void start(const QUrl& url, const QString& username, const SecureString& password,
+               const QByteArray& etag = {});
+    void cancel();
+
+signals:
+    void sig_finished(MobileBookDownload::Result result, const QByteArray& data,
+                      const QByteArray& etag, int http_status);
+
+private:
+    void readAvailable();
+    void finish(Result result);
+    void onFinished();
+
+    QNetworkAccessManager manager_;
+    QPointer<QNetworkReply> reply_;
+    QTimer deadline_;
+    QByteArray data_;
+    bool finished_ = false;
+    bool conditional_ = false;
+    bool started_ = false;
+};
+
+#endif
