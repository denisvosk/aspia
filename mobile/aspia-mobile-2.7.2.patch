+void addHost(proto::address_book::ComputerGroup* group, bool inherit, const char* name)
+{
+    auto* host = group->add_computer();
+    host->set_name(name);
+    host->set_address("192.0.2.20");
+    host->set_port(8050);
+    host->mutable_inherit()->set_credentials(inherit);
+    host->set_username("own-login");
+    host->set_password("own-password");
+}
