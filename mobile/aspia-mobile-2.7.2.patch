diff --git a/source/client/legacy_router_adapter.cc b/source/client/legacy_router_adapter.cc
new file mode 100644
index 0000000000000000000000000000000000000000..c5f8d3c642c4b68375200c813598d53d0c89a924
--- /dev/null
+++ b/source/client/legacy_router_adapter.cc
@@ -0,0 +1,103 @@
+// Aspia+ compatibility with the Aspia 2.7 Router protocol.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#include "client/legacy_router_adapter.h"
+
+#include "base/serialization.h"
+#include "proto/router_constants.h"
+#include "proto/router_legacy_host.h"
+
+std::optional<LegacyRouterAdapter::Request> LegacyRouterAdapter::request(const QByteArray& buffer)
+{
+    proto::router::ClientToRouter source;
+    if (!parse(buffer, &source))
+        return std::nullopt;
+
+    proto::router::legacy::PeerToRouter target;
+    if (source.has_connection_request() && !source.has_check_host_status())
+    {
+        const auto& request = source.connection_request();
+        if (request.request_id() <= 0 || request.host_id() == 0)
+            return std::nullopt;
+        target.mutable_connection_request()->set_host_id(request.host_id());
+        return Request{Kind::CONNECTION, request.request_id(), serialize(target)};
+    }
+    if (source.has_check_host_status() && !source.has_connection_request())
+    {
+        const auto& request = source.check_host_status();
+        if (request.request_id() <= 0 || request.host_id() == 0)
+            return std::nullopt;
+        target.mutable_check_host_status()->set_host_id(request.host_id());
+        return Request{Kind::HOST_STATUS, request.request_id(), serialize(target)};
+    }
+    return std::nullopt;
+}
+
+std::optional<proto::router::RouterToClient> LegacyRouterAdapter::reply(
+    const Request& request, const QByteArray& buffer)
+{
+    proto::router::legacy::RouterToPeer source;
+    if (!parse(buffer, &source))
+        return std::nullopt;
+
+    proto::router::RouterToClient target;
+    if (request.kind == Kind::CONNECTION && source.has_connection_offer() &&
+        !source.has_host_status() && !source.has_host_id_response())
+    {
+        const auto& offer = source.connection_offer();
+        if (offer.peer_role() != proto::router::legacy::ConnectionOffer::CLIENT)
+            return std::nullopt;
+
+        auto* result = target.mutable_connection_offer();
+        result->set_request_id(request.id);
+        switch (offer.error_code())
+        {
+            case proto::router::legacy::ConnectionOffer::SUCCESS:
+                if (offer.relay().host().empty() || offer.relay().port() == 0 ||
+                    offer.relay().port() > 65535 || !offer.relay().has_key() ||
+                    offer.relay().secret().empty())
+                {
+                    return std::nullopt;
+                }
+                result->set_error_code(proto::router::kErrorOk);
+                result->mutable_relay()->CopyFrom(offer.relay());
+                result->mutable_peer_info()->set_is_legacy(true);
+                break;
+            case proto::router::legacy::ConnectionOffer::PEER_NOT_FOUND:
+                // 2.x cannot distinguish an offline host from a removed host. Preserve credentials.
+                result->set_error_code(proto::router::kErrorHostOffline);
+                break;
+            case proto::router::legacy::ConnectionOffer::ACCESS_DENIED:
+                result->set_error_code(proto::router::kErrorAccessDenied);
+                break;
+            case proto::router::legacy::ConnectionOffer::KEY_POOL_EMPTY:
+                result->set_error_code(proto::router::kErrorKeyPoolEmpty);
+                break;
+            default:
+                result->set_error_code(proto::router::kErrorInternalError);
+                break;
+        }
+        return target;
+    }
+    if (request.kind == Kind::HOST_STATUS && source.has_host_status() &&
+        !source.has_connection_offer() && !source.has_host_id_response())
+    {
+        auto* result = target.mutable_host_status();
+        result->set_request_id(request.id);
+        switch (source.host_status().status())
+        {
+            case proto::router::legacy::HostStatus::STATUS_ONLINE:
+                result->set_error_code(proto::router::kErrorOk);
+                break;
+            case proto::router::legacy::HostStatus::STATUS_OFFLINE:
+                result->set_error_code(proto::router::kErrorHostOffline);
+                break;
+            default:
+                result->set_error_code(proto::router::kErrorInternalError);
+                break;
+        }
+        // An old Router does not report the Host version. Leave it unknown instead of inventing it.
+        return target;
+    }
+    return std::nullopt;
+}
diff --git a/source/client/legacy_router_adapter.h b/source/client/legacy_router_adapter.h
new file mode 100644
index 0000000000000000000000000000000000000000..0fdb5f8bab4627b0feeb9b99af496ab0ecf14a1f
--- /dev/null
+++ b/source/client/legacy_router_adapter.h
@@ -0,0 +1,30 @@
+// Aspia+ compatibility with the Aspia 2.7 Router protocol.
+// SPDX-License-Identifier: GPL-3.0-or-later
+
+#ifndef CLIENT_LEGACY_ROUTER_ADAPTER_H
+#define CLIENT_LEGACY_ROUTER_ADAPTER_H
+
+#include <optional>
+#include <QByteArray>
+
+#include "proto/router_client.h"
+
+// The old protocol has no request IDs. The caller must send only one request at a time and
+// discard the entire channel on timeout; a late reply must never be attached to another request.
+class LegacyRouterAdapter final
+{
+public:
+    enum class Kind { CONNECTION, HOST_STATUS };
+    struct Request
+    {
+        Kind kind;
+        qint64 id;
+        QByteArray payload;
+    };
+
+    static std::optional<Request> request(const QByteArray& buffer);
+    static std::optional<proto::router::RouterToClient> reply(
+        const Request& request, const QByteArray& buffer);
+};
+
+#endif // CLIENT_LEGACY_ROUTER_ADAPTER_H
