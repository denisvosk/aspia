@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Exercise the generated Caddy endpoint against a real, loopback-only Caddy process.
+
+This does not publish user data, contact the production IP, or alter the server.
+Run Test-Mobile-Book.ps1 first to produce the fixtures.
+"""
+from __future__ import annotations
+
+import argparse
+import base64
+import http.client
+import json
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import time
+
+
+def check(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--caddy", required=True, type=Path)
+    parser.add_argument("--fixtures", required=True, type=Path)
+    args = parser.parse_args()
+    caddy = args.caddy.resolve()
+    fixtures = args.fixtures.resolve()
+    source_block = (fixtures / "mobile-block.caddy").read_text(encoding="utf-8-sig")
+    payload = (fixtures / "book.aab").read_bytes()
+    with tempfile.TemporaryDirectory(prefix="aspia-mobile-route-") as temporary:
+        directory = Path(temporary)
+        private = directory / "private"
+        public = directory / "public"
+        private.mkdir()
+        public.mkdir()
+        (private / "book.aab").write_bytes(payload)
+        (private / "must-not-leak.txt").write_text("PRIVATE SENTINEL", encoding="utf-8")
+        (public / "index.html").write_text("Existing public site", encoding="utf-8")
+        block = source_block.replace("C:/Web/Aspia/private-mobile", private.as_posix())
+        check(block != source_block, "The generated Windows root was not substituted for the local test.")
+        with socket.socket() as reserve:
+            reserve.bind(("127.0.0.1", 0))
+            port = reserve.getsockname()[1]
+        config = directory / "Caddyfile"
+        config.write_text(
+            "{\n    admin off\n    auto_https off\n}\n"
+            f"http://127.0.0.1:{port} {{\n"
+            + block
+            + f'\n    handle {{\n        root * "{public.as_posix()}"\n        file_server\n    }}\n}}\n',
+            encoding="utf-8",
+        )
+        subprocess.run(
+            [str(caddy), "validate", "--config", str(config), "--adapter", "caddyfile"],
+            check=True, capture_output=True, timeout=30,
+        )
+        with (directory / "caddy.log").open("wb") as log:
+            process = subprocess.Popen(
+                [str(caddy), "run", "--config", str(config), "--adapter", "caddyfile"],
+                stdout=log, stderr=subprocess.STDOUT,
+            )
+            try:
+                deadline = time.monotonic() + 10
+                while True:
+                    if process.poll() is not None:
+                        raise RuntimeError((directory / "caddy.log").read_text())
+                    try:
+                        with socket.create_connection(("127.0.0.1", port), timeout=0.2):
+                            break
+                    except OSError:
+                        if time.monotonic() >= deadline:
+                            raise RuntimeError("Local test Caddy did not become ready.")
+                        time.sleep(0.05)
+
+                def request(path: str, method: str = "GET", password: str | None = None,
+                            extra_headers: dict[str, str] | None = None) -> tuple[int, dict[str, str], bytes]:
+                    headers = dict(extra_headers or {})
+                    if password is not None:
+                        token = base64.b64encode(f"mobile:{password}".encode()).decode("ascii")
+                        headers["Authorization"] = "Basic " + token
+                    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=5)
+                    try:
+                        connection.request(method, path, headers=headers)
+                        response = connection.getresponse()
+                        return response.status, {key.lower(): value for key, value in response.getheaders()}, response.read()
+                    finally:
+                        connection.close()
+
+                checks = 0
+                status, headers, body = request("/mobile-book/book.aab")
+                check(status == 401 and payload not in body, "Anonymous access was allowed."); checks += 1
+                check("basic" in headers.get("www-authenticate", "").lower(), "No Basic authentication challenge."); checks += 1
+                check(request("/mobile-book/book.aab", password="wrong")[0] == 401, "Wrong password was accepted."); checks += 1
+                password = "AspiaPlusMobile-Test-Only"
+                status, headers, body = request("/mobile-book/book.aab", password=password)
+                check(status == 200 and body == payload, "Authorized GET did not return the exact book."); checks += 1
+                check(headers.get("cache-control") == "private, no-store", "Private no-store header missing."); checks += 1
+                check(headers.get("x-content-type-options") == "nosniff", "nosniff header missing."); checks += 1
+                check(headers.get("content-type") == "application/octet-stream", "Incorrect book content type."); checks += 1
+                etag = headers.get("etag")
+                check(bool(etag), "Caddy did not provide an ETag."); checks += 1
+                check(request("/mobile-book/book.aab", password=password, extra_headers={"If-None-Match": etag})[0] == 304,
+                      "Conditional refresh did not return 304."); checks += 1
+                status, head_headers, body = request("/mobile-book/book.aab", method="HEAD", password=password)
+                check(status == 200 and body == b"" and int(head_headers["content-length"]) == len(payload), "HEAD failed."); checks += 1
+                check(request("/mobile-book/book.aab", method="POST", password=password)[0] == 405, "POST was allowed."); checks += 1
+                check(request("/mobile-book/book.aab", method="POST")[0] == 401, "Authentication does not precede method rejection."); checks += 1
+                for path in ("/mobile-book", "/mobile-book/", "/mobile-book/must-not-leak.txt", "/mobile-book/book.aab/must-not-leak.txt",
+                             "/mobile-book/../private/must-not-leak.txt", "/mobile-book/%2e%2e/private/must-not-leak.txt",
+                             "/mobile-book/book.aab%2f..%2fmust-not-leak.txt"):
+                    status, _, body = request(path, password=password)
+                    check(status in (400, 404) and b"PRIVATE SENTINEL" not in body and body != payload,
+                          f"An adjacent/traversal path was exposed: {path} ({status}).")
+                    checks += 1
+                status, _, body = request("/")
+                check(status == 200 and body == b"Existing public site", "The existing public route was broken."); checks += 1
+                print(f"PASS: {checks} real-Caddy endpoint/authentication/isolation checks")
+            finally:
+                process.terminate()
+                try:
+                    process.wait(timeout=5)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait(timeout=5)
+
+
+if __name__ == "__main__":
+    main()
